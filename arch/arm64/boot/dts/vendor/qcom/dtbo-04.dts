				qcom,panel-supply-entry@0 {
					reg = <0x00>;
					qcom,supply-name = "vddio";
					qcom,supply-min-voltage = <0x1b7740>;
					qcom,supply-max-voltage = <0x1b7740>;
					qcom,supply-enable-load = <0xf230>;
					qcom,supply-disable-load = <0x50>;
					qcom,supply-post-on-sleep = <0x14>;
				};

				qcom,panel-supply-entry@1 {
					reg = <0x01>;
					qcom,supply-name = "lab";
					qcom,supply-min-voltage = <0x4630c0>;
					qcom,supply-max-voltage = <0x5b8d80>;
					qcom,supply-enable-load = <0x186a0>;
					qcom,supply-disable-load = <0x64>;
				};

				qcom,panel-supply-entry@2 {
					reg = <0x02>;
					qcom,supply-name = "ibb";
					qcom,supply-min-voltage = <0x4630c0>;
					qcom,supply-max-voltage = <0x5b8d80>;
					qcom,supply-enable-load = <0x186a0>;
					qcom,supply-disable-load = <0x64>;
					qcom,supply-post-on-sleep = <0x14>;
				};
			};

			sde_dsi: qcom,dsi-display-primary {
				compatible = "qcom,dsi-display";
				label = "primary";
				qcom,dsi-ctrl = <&mdss_dsi0 &mdss_dsi1>;
				qcom,dsi-phy = <&mdss_dsi_phy0 &mdss_dsi_phy1>;
				clocks = <&mdss_dsi0_pll 0x06 &mdss_dsi0_pll 0x09 &mdss_dsi0_pll 0x03 &mdss_dsi0_pll 0x08 &mdss_dsi0_pll 0x0d &mdss_dsi0_pll 0x11 &mdss_dsi1_pll 0x20 &mdss_dsi1_pll 0x23 &mdss_dsi1_pll 0x1d &mdss_dsi1_pll 0x22 &mdss_dsi1_pll 0x27 &mdss_dsi1_pll 0x2b &rpmhcc 0x04>;
				clock-names = "mux_byte_clk0\0mux_pixel_clk0\0src_byte_clk0\0src_pixel_clk0\0shadow_byte_clk0\0shadow_pixel_clk0\0mux_byte_clk1\0mux_pixel_clk1\0src_byte_clk1\0src_pixel_clk1\0shadow_byte_clk1\0shadow_pixel_clk1\0bb_clk2";
				pinctrl-names = "panel_active\0panel_suspend";
				pinctrl-0 = <&sde_te_active &disp_pins_default>;
				pinctrl-1 = <&sde_te_suspend>;
				qcom,platform-te-gpio = <&tlmm 0x0a 0x00>;
				qcom,panel-te-source = <0x00>;
				vddio-supply = <&L1C>;
				vdd-supply = <&L16A>;
				qcom,mdp = <&mdss_mdp>;
				qcom,dsi-default-panel = <&dsi_sw43404_amoled_video>;
			};

			sde_dsi1: qcom,dsi-display-secondary {
				compatible = "qcom,dsi-display";
				label = "secondary";
				qcom,dsi-ctrl = <&mdss_dsi0 &mdss_dsi1>;
				qcom,dsi-phy = <&mdss_dsi_phy0 &mdss_dsi_phy1>;
				clocks = <&mdss_dsi0_pll 0x06 &mdss_dsi0_pll 0x09 &mdss_dsi1_pll 0x20 &mdss_dsi1_pll 0x23>;
				clock-names = "mux_byte_clk0\0mux_pixel_clk0\0mux_byte_clk1\0mux_pixel_clk1";
				pinctrl-names = "panel_active\0panel_suspend";
				pinctrl-0 = <&sde_te1_active>;
				pinctrl-1 = <&sde_te1_suspend>;
				qcom,platform-te-gpio = <&tlmm 0x0b 0x00>;
				qcom,panel-te-source = <0x01>;
				vddio-supply = <&L1C>;
				vdd-supply = <&L16A>;
				qcom,mdp = <&mdss_mdp>;
			};

			sde_wb: qcom,wb-display@0 {
				compatible = "qcom,wb-display";
				cell-index = <0x00>;
				label = "wb_display";
			};

			msm_notifier: qcom,msm_notifier@0 {
				compatible = "qcom,msm-notifier";
				panel = <&dsi_sw43404_amoled_cmd &dsi_sharp_qsync_wqhd_cmd &dsi_dual_sim_dsc_375_cmd &dsi_sw43404_amoled_video &dsi_sharp_qsync_wqhd_video &dsi_sharp_qsync_fhd_cmd &dsi_sharp_qsync_fhd_video &dsi_rm692a9_visionox_amoled_cmd &dsi_old_rm692a9_visionox_amoled_cmd>;
			};
		};
	};

	fragment@43 {
		target = <&sde_dp>;

		__overlay__ {
			qcom,dp-usbpd-detection = <&pm7250b_pdphy>;
			qcom,ext-disp = <&ext_disp>;
			qcom,dp-aux-switch = <&fsa4480>;
			qcom,usbplug-cc-gpio = <&tlmm 0x72 0x00>;
			pinctrl-names = "mdss_dp_active\0mdss_dp_sleep";
			pinctrl-0 = <&sde_dp_usbplug_cc_active>;
			pinctrl-1 = <&sde_dp_usbplug_cc_suspend>;
		};
	};

	fragment@44 {
		target = <&mdss_mdp>;

		__overlay__ {
			connectors = <&sde_wb &sde_dsi &sde_dsi1 &sde_dp &sde_rscc>;
		};
	};

	fragment@45 {
		target = <&mdss_mdp>;

		__overlay__ {
			#cooling-cells = <0x02>;
		};
	};

	fragment@46 {
		target = <&thermal_zones>;

		__overlay__ {

			pm7250b-tz {

				cooling-maps {

					trip0_bat {
						trip = <&pm7250b_trip0>;
						cooling-device = <&pm7250b_charger 0xfffffffc 0xfffffffc>;
					};

					trip1_bat {
						trip = <&pm7250b_trip1>;
						cooling-device = <&pm7250b_charger 0xfffffffd 0xfffffffd>;
					};

					trip2_bat {
						trip = <&pm7250b_trip2>;
						cooling-device = <&pm7250b_charger 0xfffffffe 0xfffffffe>;
					};
				};
			};

			pm8150_tz {

				cooling-maps {

					trip0_cpu0 {
						trip = <&pm8150_trip0>;
						cooling-device = <&CPU0 0xfffffffe 0xfffffffe>;
					};

					trip0_cpu6 {
						trip = <&pm8150_trip0>;
						cooling-device = <&CPU6 0xfffffffe 0xfffffffe>;
					};

					trip0_cpu7 {
						trip = <&pm8150_trip0>;
						cooling-device = <&CPU7 0xfffffffe 0xfffffffe>;
					};

					trip1_cpu1 {
						trip = <&pm8150_trip1>;
						cooling-device = <&cpu1_isolate 0x01 0x01>;
					};

					trip1_cpu2 {
						trip = <&pm8150_trip1>;
						cooling-device = <&cpu2_isolate 0x01 0x01>;
					};

					trip1_cpu3 {
						trip = <&pm8150_trip1>;
						cooling-device = <&cpu3_isolate 0x01 0x01>;
					};

					trip1_cpu4 {
						trip = <&pm8150_trip1>;
						cooling-device = <&cpu4_isolate 0x01 0x01>;
					};

					trip1_cpu5 {
						trip = <&pm8150_trip1>;
						cooling-device = <&cpu5_isolate 0x01 0x01>;
					};

					trip1_cpu6 {
						trip = <&pm8150_trip1>;
						cooling-device = <&cpu6_isolate 0x01 0x01>;
					};

					trip1_cpu7 {
						trip = <&pm8150_trip1>;
						cooling-device = <&cpu7_isolate 0x01 0x01>;
					};
				};
			};

			soc {

				cooling-maps {

					soc_cpu6 {
						trip = <&soc_trip>;
						cooling-device = <&cpu6_isolate 0x01 0x01>;
					};

					soc_cpu7 {
						trip = <&soc_trip>;
						cooling-device = <&cpu7_isolate 0x01 0x01>;
					};
				};
			};

			pm7250b-bcl-lvl0 {

				cooling-maps {

					lbat0_cpu6 {
						trip = <&b_bcl_lvl0>;
						cooling-device = <&cpu6_isolate 0x01 0x01>;
					};

					lbat0_cpu7 {
						trip = <&b_bcl_lvl0>;
						cooling-device = <&cpu7_isolate 0x01 0x01>;
					};
				};
			};

			pm7250b-bcl-lvl1 {

				cooling-maps {

					lbat1_cpu6 {
						trip = <&b_bcl_lvl1>;
						cooling-device = <&cpu6_isolate 0x01 0x01>;
					};

					lbat1_cpu7 {
						trip = <&b_bcl_lvl1>;
						cooling-device = <&cpu7_isolate 0x01 0x01>;
					};
				};
			};

			pm7250b-bcl-lvl2 {

				cooling-maps {

					lbat2_cpu6 {
						trip = <&b_bcl_lvl2>;
						cooling-device = <&cpu6_isolate 0x01 0x01>;
					};

					lbat2_cpu7 {
						trip = <&b_bcl_lvl2>;
						cooling-device = <&cpu7_isolate 0x01 0x01>;
					};
				};
			};

			pm8150l-bcl-lvl0 {
				disable-thermal-zone;

				cooling-maps {

					vph_cpu6 {
						trip = <&l_bcl_lvl0>;
						cooling-device = <&cpu6_isolate 0x01 0x01>;
					};

					vph_cpu7 {
						trip = <&l_bcl_lvl0>;
						cooling-device = <&cpu7_isolate 0x01 0x01>;
					};
				};
			};

			pm8150l-bcl-lvl1 {
				disable-thermal-zone;

				cooling-maps {

					vph_cpu6 {
						trip = <&l_bcl_lvl1>;
						cooling-device = <&cpu6_isolate 0x01 0x01>;
					};

					vph_cpu7 {
						trip = <&l_bcl_lvl1>;
						cooling-device = <&cpu7_isolate 0x01 0x01>;
					};
				};
			};

			pm8150l-bcl-lvl2 {
				disable-thermal-zone;

				cooling-maps {

					vph_cpu6 {
						trip = <&l_bcl_lvl2>;
						cooling-device = <&cpu6_isolate 0x01 0x01>;
					};

					vph_cpu7 {
						trip = <&l_bcl_lvl2>;
						cooling-device = <&cpu7_isolate 0x01 0x01>;
					};
				};
			};
		};
	};

	fragment@47 {
		target = <&soc>;

		__overlay__ {

			gpio_keys {
				compatible = "gpio-keys";
				label = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&key_vol_up_default>;

				vol_up {
					label = "volume_up";
					gpios = <&pm8150l_gpios 0x05 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x73>;
					gpio-key,wakeup;
					debounce-interval = <0x0f>;
					linux,can-disable;
				};
			};

			vdda_usb_ss_dp_core: vdda_usb_ss_dp_core {
				compatible = "regulator-fixed";
				regulator-name = "vdd_supply";
				regulator-min-microvolt = <0xd6d80>;
				regulator-max-microvolt = <0xd6d80>;
				enable-active-high;
				gpio = <&pm8150l_gpios 0x0c 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&usb_eldo13>;
			};
		};
	};

	fragment@48 {
		target = <&usb_qmp_dp_phy>;

		__overlay__ {
			vdd-supply = <&vdda_usb_ss_dp_core>;
		};
	};

	fragment@49 {
		target = <&ufsphy_mem>;

		__overlay__ {
			compatible = "qcom,ufs-phy-qmp-v4-lito";
			vdda-phy-supply = <&pm8150_l5>;
			vdda-pll-supply = <&pm8150_l9>;
			vdda-phy-max-microamp = <0x16058>;
			vdda-pll-max-microamp = <0x4a38>;
			status = "ok";
		};
	};

	fragment@50 {
		target = <&ufshc_mem>;

		__overlay__ {
			vdd-hba-supply = <&ufs_phy_gdsc>;
			vdd-hba-fixed-regulator;
			vcc-supply = <&pm8150a_l7>;
			vcc-voltage-level = <0x2d0370 0x2d2a80>;
			vccq2-supply = <&pm8150_s4>;
			vcc-max-microamp = [00 0c 35 00];
			vccq2-max-microamp = [00 0c 35 00];
			qcom,vddp-ref-clk-supply = <&pm8150_l9>;
			qcom,vddp-ref-clk-max-microamp = <0x64>;
			qcom,vddp-ref-clk-min-uV = <0x119400>;
			qcom,vddp-ref-clk-max-uV = <0x124f80>;
			status = "ok";
		};
	};

	fragment@51 {
		target = <&sdhc_1>;

		__overlay__ {
			vdd-supply = <&pm8150a_l7>;
			qcom,vdd-voltage-level = <0x2d0370 0x2d0370>;
			qcom,vdd-current-level = <0x00 0x8b290>;
			vdd-io-supply = <&pm8150_s4>;
			qcom,vdd-io-always-on;
			qcom,vdd-io-lpm-sup;
			qcom,vdd-io-voltage-level = <0x1b7740 0x1b7740>;
			qcom,vdd-io-current-level = <0x00 0x4f588>;
			pinctrl-names = "active\0sleep";
			pinctrl-0 = <&sdc1_clk_on &sdc1_cmd_on &sdc1_data_on &sdc1_rclk_on>;
			pinctrl-1 = <&sdc1_clk_off &sdc1_cmd_off &sdc1_data_off &sdc1_rclk_off>;
			status = "ok";
		};
	};

	fragment@52 {
		target = <&sdhc_2>;

		__overlay__ {
			vdd-supply = <&pm8150a_l9>;
			qcom,vdd-voltage-level = <0x2d0370 0x2d0370>;
			qcom,vdd-current-level = <0x00 0xc3500>;
			vdd-io-supply = <&pm8150a_l6>;
			qcom,vdd-io-voltage-level = <0x1b7740 0x2d0370>;
			qcom,vdd-io-current-level = <0x00 0x55f0>;
			pinctrl-names = "active\0sleep";
			pinctrl-0 = <&sdc2_clk_on &sdc2_cmd_on &sdc2_data_on &sdc2_cd_on>;
			pinctrl-1 = <&sdc2_clk_off &sdc2_cmd_off &sdc2_data_off &sdc2_cd_off>;
			cd-gpios = <&tlmm 0x45 0x01>;
			status = "ok";
		};
	};

	fragment@53 {
		target = <&qupv3_se7_i2c>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "ok";
			qcom,i2c-touch-active = "st,fts";

			st_fts@49 {
				compatible = "st,fts";
				reg = <0x49>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x09 0x2008>;
				vdd-supply = <&pm8150_s4>;
				avdd-supply = <&pm8150_l13>;
				pinctrl-names = "pmx_ts_active\0pmx_ts_suspend";
				pinctrl-0 = <&ts_active>;
				pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
				st,irq-gpio = <&tlmm 0x09 0x2008>;
				st,reset-gpio = <&tlmm 0x08 0x00>;
				st,regulator_dvdd = "vdd";
				st,regulator_avdd = "avdd";
			};
		};
	};

	fragment@54 {
		target = <&qupv3_se0_i2c>;

		__overlay__ {
			status = "ok";
			qcom,clk-freq-out = <0xf4240>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			nq@28 {
				compatible = "qcom,nq-nci";
				reg = <0x28>;
				qcom,nq-irq = <&tlmm 0x22 0x00>;
				qcom,nq-ven = <&tlmm 0x0c 0x00>;
				qcom,nq-firm = <&tlmm 0x23 0x00>;
				qcom,nq-clkreq = <&tlmm 0x1f 0x00>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x22 0x00>;
				interrupt-names = "nfc_irq";
				pinctrl-names = "nfc_active\0nfc_suspend";
				pinctrl-0 = <&nfc_int_active &nfc_enable_active &nfc_clk_req_active>;
				pinctrl-1 = <&nfc_int_suspend &nfc_enable_suspend &nfc_clk_req_suspend>;
			};
		};
	};
};
