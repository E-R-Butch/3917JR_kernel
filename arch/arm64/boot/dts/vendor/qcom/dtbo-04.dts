					quat_mi2s_sd0_sleep: quat_mi2s_sd0_sleep {

						mux {
							pins = "gpio2";
							function = "func2";
						};

						config {
							pins = "gpio2";
							drive-strength = <0x02>;
							bias-pull-down;
							input-enable;
						};
					};

					quat_mi2s_sd0_active: quat_mi2s_sd0_active {

						mux {
							pins = "gpio2";
							function = "func2";
						};

						config {
							pins = "gpio2";
							drive-strength = <0x08>;
							bias-disable;
