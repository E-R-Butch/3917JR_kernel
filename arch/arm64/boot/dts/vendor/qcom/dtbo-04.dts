	fragment@1 {
		target = <&bolero>;

		__overlay__ {
			qcom,num-macros = <0x03>;

			bolero-clk-rsc-mngr {
				compatible = "qcom,bolero-clk-rsc-mngr";
				qcom,fs-gen-sequence = <0x3000 0x01 0x3004 0x01 0x3080 0x02>;
				qcom,rx_mclk_mode_muxsel = <0x33240d8>;
				qcom,wsa_mclk_mode_muxsel = <0x33220d8>;
				qcom,va_mclk_mode_muxsel = <0x33a0000>;
				clock-names = "tx_core_clk\0tx_npl_clk\0rx_core_clk\0rx_npl_clk\0wsa_core_clk\0wsa_npl_clk\0va_core_clk\0va_npl_clk";
				clocks = <&clock_audio_tx_1 0x00 &clock_audio_tx_2 0x00 &clock_audio_rx_1 0x00 &clock_audio_rx_2 0x00 &clock_audio_wsa_1 0x00 &clock_audio_wsa_2 0x00 &clock_audio_va_1 0x00 &clock_audio_va_2 0x00>;
			};

			tx_macro: tx-macro@3220000 {
				compatible = "qcom,tx-macro";
				reg = <0x3220000 0x00>;
				clock-names = "tx_core_clk\0tx_npl_clk";
				clocks = <&clock_audio_tx_1 0x00 &clock_audio_tx_2 0x00>;
				qcom,tx-swr-gpios = <&tx_swr_gpios>;
				qcom,tx-dmic-sample-rate = <0x249f00>;

				swr2: tx_swr_master {
					compatible = "qcom,swr-mstr";
					#address-cells = <0x02>;
					#size-cells = <0x00>;
					clock-names = "lpass_core_hw_vote\0lpass_audio_hw_vote";
					clocks = <&lpass_core_hw_vote 0x00 &lpass_audio_hw_vote 0x00>;
					qcom,swr_master_id = <0x03>;
					qcom,mipi-sdw-block-packing-mode = <0x01>;
					swrm-io-base = <0x3230000 0x00>;
					interrupts-extended = <&intc 0x00 0xa6 0x04 &pdc 0x6d 0x04>;
					interrupt-names = "swr_master_irq\0swr_wake_irq";
					qcom,swr-wakeup-required = <0x01>;
					qcom,swr-num-ports = <0x05>;
					qcom,swr-port-mapping = <0x01 0x21 0x0f 0x02 0x12 0x01 0x02 0x13 0x02 0x03 0x14 0x01 0x03 0x15 0x02 0x04 0x16 0x01 0x04 0x17 0x02 0x04 0x18 0x04 0x04 0x19 0x08 0x05 0x1a 0x01 0x05 0x1b 0x02 0x05 0x1c 0x04 0x05 0x1d 0x08>;
					qcom,swr-num-dev = <0x01>;
					qcom,swr-clock-stop-mode0 = <0x01>;
					qcom,swr-mstr-irq-wakeup-capable = <0x01>;

					wcd938x_tx_slave: wcd938x-tx-slave {
						compatible = "qcom,wcd938x-slave";
						reg = <0x0d 0x1170223>;
					};
				};
			};

			rx_macro: rx-macro@3200000 {
				compatible = "qcom,rx-macro";
				reg = <0x3200000 0x00>;
				clock-names = "rx_core_clk\0rx_npl_clk";
				clocks = <&clock_audio_rx_1 0x00 &clock_audio_rx_2 0x00>;
				qcom,rx-swr-gpios = <&rx_swr_gpios>;
				qcom,rx_mclk_mode_muxsel = <0x33240d8>;
				qcom,rx-bcl-pmic-params = [00 04 3e];
				qcom,default-clk-id = <0x00>;

				swr1: rx_swr_master {
					compatible = "qcom,swr-mstr";
					#address-cells = <0x02>;
					#size-cells = <0x00>;
					clock-names = "lpass_core_hw_vote\0lpass_audio_hw_vote";
					clocks = <&lpass_core_hw_vote 0x00 &lpass_audio_hw_vote 0x00>;
					qcom,swr_master_id = <0x02>;
					qcom,mipi-sdw-block-packing-mode = <0x01>;
					swrm-io-base = <0x3210000 0x00>;
					interrupts = <0x00 0x9b 0x04>;
					interrupt-names = "swr_master_irq";
					qcom,swr-num-ports = <0x05>;
					qcom,disable-div2-clk-switch = <0x01>;
					qcom,swr-port-mapping = <0x01 0x09 0x01 0x01 0x0a 0x02 0x02 0x0d 0x01 0x03 0x0b 0x01 0x03 0x0c 0x02 0x04 0x0e 0x01 0x05 0x0f 0x01 0x05 0x10 0x02>;
					qcom,swr-num-dev = <0x01>;
					qcom,swr-clock-stop-mode0 = <0x01>;

					wcd938x_rx_slave: wcd938x-rx-slave {
						compatible = "qcom,wcd938x-slave";
						reg = <0x0d 0x1170224>;
					};
				};
			};

			va_macro: va-macro@3370000 {
				compatible = "qcom,va-macro";
				reg = <0x3370000 0x00>;
				clock-names = "lpass_audio_hw_vote";
				clocks = <&lpass_audio_hw_vote 0x00>;
				qcom,va-dmic-sample-rate = <0x927c0>;
				qcom,va-clk-mux-select = <0x01>;
				qcom,va-island-mode-muxsel = <0x33a0000>;
				qcom,default-clk-id = <0x00>;
			};

			wcd938x_codec: wcd938x-codec {
				compatible = "qcom,wcd938x-codec";
				qcom,split-codec = <0x01>;
				qcom,rx_swr_ch_map = <0x00 0x09 0x01 0x00 0x09 0x00 0x0a 0x02 0x00 0x0a 0x01 0x0d 0x01 0x00 0x0d 0x02 0x0b 0x01 0x00 0x0b 0x02 0x0c 0x02 0x00 0x0c 0x03 0x0e 0x01 0x00 0x0e 0x04 0x0f 0x01 0x00 0x0f 0x04 0x10 0x02 0x00 0x10>;
				qcom,tx_swr_ch_map = <0x00 0x12 0x01 0x00 0x12 0x00 0x13 0x02 0x00 0x13 0x01 0x14 0x01 0x00 0x14 0x01 0x15 0x02 0x00 0x15 0x02 0x16 0x01 0x00 0x16 0x02 0x17 0x02 0x00 0x17 0x02 0x11 0x04 0x00 0x18 0x02 0x18 0x04 0x00 0x18 0x02 0x19 0x08 0x00 0x19 0x03 0x1a 0x01 0x00 0x1a 0x03 0x1b 0x02 0x00 0x1b 0x03 0x1c 0x04 0x00 0x1c 0x03 0x1d 0x08 0x00 0x1d>;
				qcom,wcd-rst-gpio-node = <&wcd938x_rst_gpio>;
				qcom,rx-slave = <&wcd938x_rx_slave>;
				qcom,tx-slave = <&wcd938x_tx_slave>;
				cdc-vdd-rxtx-supply = <&S4A>;
				qcom,cdc-vdd-rxtx-voltage = <0x1b7740 0x1b7740>;
				qcom,cdc-vdd-rxtx-current = <0x7530>;
				cdc-vddio-supply = <&S4A>;
				qcom,cdc-vddio-voltage = <0x1b7740 0x1b7740>;
				qcom,cdc-vddio-current = <0x7530>;
				cdc-vdd-buck-supply = <&S4A>;
				qcom,cdc-vdd-buck-voltage = <0x1b7740 0x1b7740>;
				qcom,cdc-vdd-buck-current = <0x9eb10>;
				cdc-vdd-mic-bias-supply = <&BOB>;
				qcom,cdc-vdd-mic-bias-voltage = [00 32 4b 00 00 32 4b 00];
				qcom,cdc-vdd-mic-bias-current = <0x7530>;
				qcom,cdc-micbias1-mv = <0x708>;
				qcom,cdc-micbias2-mv = <0xa8c>;
				qcom,cdc-micbias3-mv = <0x708>;
				qcom,cdc-micbias4-mv = <0x708>;
				qcom,cdc-static-supplies = "cdc-vdd-rxtx\0cdc-vddio\0cdc-vdd-buck\0cdc-vdd-mic-bias";
			};
		};
	};

	fragment@2 {
		target = <&lito_snd>;

		__overlay__ {
			qcom,model = "lito-mtp-snd-card";
			qcom,msm-mi2s-master = <0x01 0x01 0x01 0x01 0x01 0x01>;
			qcom,wcn-btfm = <0x01>;
			qcom,ext-disp-audio-rx = <0x01>;
			qcom,tdm-max-slots = <0x08>;
			qcom,audio-routing = "AMIC1\0MIC BIAS1\0MIC BIAS1\0Analog Mic1\0AMIC2\0MIC BIAS2\0MIC BIAS2\0Analog Mic2\0AMIC3\0MIC BIAS3\0MIC BIAS3\0Analog Mic3\0AMIC4\0MIC BIAS3\0MIC BIAS3\0Analog Mic4\0AMIC5\0MIC BIAS4\0MIC BIAS4\0Analog Mic5\0TX DMIC0\0MIC BIAS3\0MIC BIAS3\0Digital Mic0\0TX DMIC1\0MIC BIAS3\0MIC BIAS3\0Digital Mic1\0TX DMIC2\0MIC BIAS1\0MIC BIAS1\0Digital Mic2\0TX DMIC3\0MIC BIAS1\0MIC BIAS1\0Digital Mic3\0TX DMIC4\0MIC BIAS4\0MIC BIAS4\0Digital Mic4\0TX DMIC5\0MIC BIAS4\0MIC BIAS4\0Digital Mic5\0IN1_HPHL\0HPHL_OUT\0IN2_HPHR\0HPHR_OUT\0IN3_AUX\0AUX_OUT\0TX SWR_ADC0\0ADC1_OUTPUT\0TX SWR_ADC1\0ADC2_OUTPUT\0TX SWR_ADC2\0ADC3_OUTPUT\0TX SWR_ADC3\0ADC4_OUTPUT\0TX SWR_DMIC0\0DMIC1_OUTPUT\0TX SWR_DMIC1\0DMIC2_OUTPUT\0TX SWR_DMIC2\0DMIC3_OUTPUT\0TX SWR_DMIC3\0DMIC4_OUTPUT\0TX SWR_DMIC4\0DMIC5_OUTPUT\0TX SWR_DMIC5\0DMIC6_OUTPUT\0TX SWR_DMIC6\0DMIC7_OUTPUT\0TX SWR_DMIC7\0DMIC8_OUTPUT\0WSA SRC0_INP\0SRC0\0WSA_TX DEC0_INP\0TX DEC0 MUX\0WSA_TX DEC1_INP\0TX DEC1 MUX\0RX_TX DEC0_INP\0TX DEC0 MUX\0RX_TX DEC1_INP\0TX DEC1 MUX\0RX_TX DEC2_INP\0TX DEC2 MUX\0RX_TX DEC3_INP\0TX DEC3 MUX\0SpkrLeft IN\0WSA_SPK1 OUT\0SpkrRight IN\0WSA_SPK2 OUT\0VA_AIF1 CAP\0VA_SWR_CLK\0VA_AIF2 CAP\0VA_SWR_CLK\0VA_AIF3 CAP\0VA_SWR_CLK\0VA MIC BIAS3\0Digital Mic0\0VA MIC BIAS3\0Digital Mic1\0VA MIC BIAS1\0Digital Mic2\0VA MIC BIAS1\0Digital Mic3\0VA MIC BIAS4\0Digital Mic4\0VA MIC BIAS4\0Digital Mic5\0VA DMIC0\0VA MIC BIAS3\0VA DMIC1\0VA MIC BIAS3\0VA DMIC2\0VA MIC BIAS1\0VA DMIC3\0VA MIC BIAS1\0VA DMIC4\0VA MIC BIAS4\0VA DMIC5\0VA MIC BIAS4\0VA SWR_ADC0\0VA_SWR_CLK\0VA SWR_ADC1\0VA_SWR_CLK\0VA SWR_ADC2\0VA_SWR_CLK\0VA SWR_ADC3\0VA_SWR_CLK\0VA SWR_MIC0\0VA_SWR_CLK\0VA SWR_MIC1\0VA_SWR_CLK\0VA SWR_MIC2\0VA_SWR_CLK\0VA SWR_MIC3\0VA_SWR_CLK\0VA SWR_MIC4\0VA_SWR_CLK\0VA SWR_MIC5\0VA_SWR_CLK\0VA SWR_MIC6\0VA_SWR_CLK\0VA SWR_MIC7\0VA_SWR_CLK\0VA SWR_ADC0\0ADC1_OUTPUT\0VA SWR_ADC1\0ADC2_OUTPUT\0VA SWR_ADC2\0ADC3_OUTPUT\0VA SWR_ADC3\0ADC4_OUTPUT\0VA SWR_MIC0\0DMIC1_OUTPUT\0VA SWR_MIC1\0DMIC2_OUTPUT\0VA SWR_MIC2\0DMIC3_OUTPUT\0VA SWR_MIC3\0DMIC4_OUTPUT\0VA SWR_MIC4\0DMIC5_OUTPUT\0VA SWR_MIC5\0DMIC6_OUTPUT\0VA SWR_MIC6\0DMIC7_OUTPUT\0VA SWR_MIC7\0DMIC8_OUTPUT";
			qcom,msm-mbhc-hphl-swh = <0x01>;
			qcom,msm-mbhc-gnd-swh = <0x01>;
			qcom,cdc-dmic01-gpios = <&cdc_dmic01_gpios>;
			qcom,cdc-dmic23-gpios = <&cdc_dmic23_gpios>;
			qcom,cdc-dmic45-gpios = <&cdc_dmic45_gpios>;
			asoc-codec = <&stub_codec &bolero &ext_disp_audio_codec>;
			asoc-codec-names = "msm-stub-codec.1\0bolero_codec\0msm-ext-disp-audio-codec-rx";
			qcom,wsa-max-devs = <0x00>;
			qcom,wsa-aux-dev-prefix = "SpkrLeft\0SpkrRight\0SpkrLeft\0SpkrRight";
			qcom,codec-max-aux-devs = <0x01>;
			qcom,codec-aux-devs = <&wcd938x_codec>;
			qcom,msm_audio_ssr_devs = <&audio_apr &q6core &lpi_tlmm &bolero>;
		};
	};

	fragment@3 {
		target = <&q6core>;

		__overlay__ {

			cdc_dmic01_gpios: cdc_dmic01_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active\0aud_sleep";
				pinctrl-0 = <&cdc_dmic01_clk_active &cdc_dmic01_data_active>;
				pinctrl-1 = <&cdc_dmic01_clk_sleep &cdc_dmic01_data_sleep>;
				qcom,lpi-gpios;
				qcom,tlmm-gpio = <0x79 0x7a>;
			};

			cdc_dmic23_gpios: cdc_dmic23_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active\0aud_sleep";
				pinctrl-0 = <&cdc_dmic23_clk_active &cdc_dmic23_data_active>;
				pinctrl-1 = <&cdc_dmic23_clk_sleep &cdc_dmic23_data_sleep>;
				qcom,lpi-gpios;
				qcom,tlmm-gpio = <0x7c>;
			};

			cdc_dmic45_gpios: cdc_dmic45_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active\0aud_sleep";
				pinctrl-0 = <&cdc_dmic45_clk_active &cdc_dmic45_data_active>;
				pinctrl-1 = <&cdc_dmic45_clk_sleep &cdc_dmic45_data_sleep>;
				qcom,lpi-gpios;
				qcom,tlmm-gpio = <0x7f 0x80>;
			};

			rx_swr_gpios: rx_swr_clk_data_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active\0aud_sleep";
				pinctrl-0 = <&rx_swr_clk_active &rx_swr_data_active &rx_swr_data1_active>;
				pinctrl-1 = <&rx_swr_clk_sleep &rx_swr_data_sleep &rx_swr_data1_sleep>;
				qcom,lpi-gpios;
			};

			tx_swr_gpios: tx_swr_clk_data_pinctrl {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active\0aud_sleep";
				pinctrl-0 = <&tx_swr_clk_active &tx_swr_data1_active &tx_swr_data2_active &tx_swr_data3_active>;
				pinctrl-1 = <&tx_swr_clk_sleep &tx_swr_data1_sleep &tx_swr_data2_sleep &tx_swr_data3_sleep>;
				qcom,lpi-gpios;
				qcom,tlmm-gpio = <0x73 0x74 0x75>;
			};
		};
	};

	fragment@4 {
		target = <&soc>;

		__overlay__ {

			wcd938x_rst_gpio: msm_cdc_pinctrl@57 {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active\0aud_sleep";
				pinctrl-0 = <&wcd938x_reset_active>;
				pinctrl-1 = <&wcd938x_reset_sleep>;
			};

			clock_audio_wsa_1: wsa_core_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x03>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-lpass-clk-id = <0x309>;
				#clock-cells = <0x01>;
			};

			clock_audio_wsa_2: wsa_npl_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x04>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-lpass-clk-id = <0x30a>;
				#clock-cells = <0x01>;
			};

			clock_audio_rx_1: rx_core_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x05>;
				qcom,codec-lpass-ext-clk-freq = <0x1588800>;
				qcom,codec-lpass-clk-id = <0x30e>;
				#clock-cells = <0x01>;
			};

			clock_audio_rx_2: rx_npl_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x06>;
				qcom,codec-lpass-ext-clk-freq = <0x1588800>;
				qcom,codec-lpass-clk-id = <0x30f>;
				#clock-cells = <0x01>;
			};

			clock_audio_tx_1: tx_core_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x07>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-lpass-clk-id = <0x30c>;
				#clock-cells = <0x01>;
			};

			clock_audio_tx_2: tx_npl_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x08>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-lpass-clk-id = <0x30d>;
				#clock-cells = <0x01>;
			};

			clock_audio_va_1: va_core_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x02>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-lpass-clk-id = <0x30b>;
				#clock-cells = <0x01>;
			};

			clock_audio_va_2: va_npl_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x0a>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-lpass-clk-id = <0x310>;
				#clock-cells = <0x01>;
			};
		};
	};

	fragment@5 {
		target = <&va_cdc_dma_0_tx>;

		__overlay__ {
			qcom,msm-dai-is-island-supported = <0x01>;
		};
	};

	fragment@6 {
		target = <&adsp_loader>;

		__overlay__ {
			nvmem-cells = <&adsp_variant>;
			nvmem-cell-names = "adsp_variant";
			adsp-fw-names = "adsp2";
			adsp-fw-bit-values = <0x02>;
		};
	};

	fragment@7 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8150@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
					interrupts = <0x00 0x08 0x00 0x03 0x00 0x08 0x01 0x03>;
					interrupt-names = "kpdpwr\0resin";
					qcom,pon-dbc-delay = <0x3d09>;
					qcom,kpdpwr-sw-debounce;
					qcom,system-reset;
					qcom,store-hard-reset-reason;

					qcom,pon_1 {
						qcom,pon-type = <0x00>;
						linux,code = <0x74>;
						qcom,pull-up;
					};

					qcom,pon_2 {
						qcom,pon-type = <0x01>;
						linux,code = <0x72>;
						qcom,pull-up;
					};
				};

				pm8150_tz: qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400 0x100>;
					interrupts = <0x00 0x24 0x00 0x03>;
					io-channels = <&pm8150_vadc 0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
				};

				pm8150_clkdiv: clock-controller@5b00 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x5b00 0x200>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x02>;
					clock-output-names = "pm8150_div_clk1\0pm8150_div_clk2";
					clocks = <&rpmhcc 0x00>;
					clock-names = "xo";
				};

				pm8150_sdam_2: sdam@b100 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb100 0x100>;
				};

				pm8150_gpios: pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					reg = <0xc000 0xa00>;
					interrupts = <0x00 0xc3 0x00 0x00>;
					interrupt-names = "pm8150_gpio4";
					gpio-controller;
					#gpio-cells = <0x02>;
					qcom,gpios-disallowed = <0x01 0x02 0x03 0x05 0x06 0x07 0x08 0x09 0x0a>;
				};

				pm8150_rtc: qcom,pm8150_rtc {
					compatible = "qcom,pm8941-rtc";
					interrupts = <0x00 0x61 0x01 0x00>;
				};

				pm8150_vadc: vadc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100 0x100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					qcom,adc-vdd-reference = <0x753>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;

					ref_gnd@0 {
						reg = <0x00>;
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vref_1p25@1 {
						reg = <0x01>;
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					die_temp@2 {
						reg = <0x06>;
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vph_pwr@83 {
						reg = <0x83>;
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					vcoin@85 {
						reg = <0x85>;
						label = "vcoin";
						qcom,pre-scaling = <0x01 0x03>;
					};

					xo_therm@4c {
						reg = <0x4c>;
						label = "xo_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pa_therm1@4d {
						reg = <0x4d>;
						label = "pa_therm1";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					bmr_e_therm@4e {
						reg = <0x4e>;
						label = "bmr_e_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};
				};

				pm8150_adc_tm: adc_tm@3500 {
					compatible = "qcom,adc-tm5";
					reg = <0x3500 0x100>;
					interrupts = <0x00 0x35 0x00 0x01>;
					interrupt-names = "thr-int-en";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					io-channels = <&pm8150_vadc 0x4c &pm8150_vadc 0x4d &pm8150_vadc 0x4e>;

					xo_therm@4c {
						reg = <0x4c>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pa_therm1@4d {
						reg = <0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					bmr_e_therm@4e {
						reg = <0x4e>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};
			};

			qcom,pm8150@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
			};
		};
	};

	fragment@8 {
		target = <&thermal_zones>;

		__overlay__ {

			pm8150_temp_alarm: pm8150_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150_tz>;
				wake-capable-sensor;

				trips {

					pm8150_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
					};

					pm8150_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@9 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm7250b@2 {
				compatible = "qcom,spmi-pmic";
				reg = <0x02 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				pm7250b_revid: qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100 0x100>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
				};

				pm7250b_charger: qcom,qpnp-smb5 {
					compatible = "qcom,qpnp-smb5";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					#cooling-cells = <0x02>;
					qcom,thermal-mitigation = <0x5265c0 0x44aa20 0x3d0900 0x3567e0 0x2dc6c0 0x2625a0 0x1e8480 0x16e360 0xf4240 0x7a120>;
					qcom,pmic-revid = <&pm7250b_revid>;
					dpdm-supply = <&usb2_phy0>;
					status = "ok";
					io-channels = <&pm7250b_vadc 0x08 &pm7250b_vadc 0x07 &pm7250b_vadc 0x09 &pm7250b_vadc 0x06 &pm7250b_vadc 0x4f &pm7250b_vadc 0x99 &pm7250b_vadc 0x83>;
					io-channel-names = "usb_in_voltage\0usb_in_current\0chg_temp\0die_temp\0conn_temp\0sbux_res\0vph_voltage";
					qcom,batteryless-platform;
					qcom,sec-charger-config = <0x01>;
					qcom,auto-recharge-soc = <0x62>;
					qcom,step-charging-enable;
					qcom,sw-jeita-enable;
					qcom,charger-temp-max = <0x320>;
					qcom,smb-temp-max = <0x320>;
					qcom,suspend-input-on-debug-batt;

					qcom,chgr@1000 {
						reg = <0x1000 0x100>;
						interrupts = <0x02 0x10 0x00 0x01 0x02 0x10 0x01 0x01 0x02 0x10 0x02 0x01 0x02 0x10 0x03 0x01 0x02 0x10 0x04 0x01 0x02 0x10 0x05 0x01 0x02 0x10 0x06 0x01 0x02 0x10 0x07 0x01>;
						interrupt-names = "chgr-error\0chg-state-change\0step-chg-state-change\0step-chg-soc-update-fail\0step-chg-soc-update-req\0fg-fvcal-qualified\0vph-alarm\0vph-drop-prechg";
					};

					qcom,dcdc@1100 {
						reg = <0x1100 0x100>;
						interrupts = <0x02 0x11 0x00 0x01 0x02 0x11 0x01 0x01 0x02 0x11 0x02 0x01 0x02 0x11 0x03 0x03 0x02 0x11 0x04 0x03 0x02 0x11 0x05 0x03 0x02 0x11 0x06 0x01 0x02 0x11 0x07 0x03>;
						interrupt-names = "otg-fail\0otg-oc-disable-sw\0otg-oc-hiccup\0bsm-active\0high-duty-cycle\0input-current-limiting\0concurrent-mode-disable\0switcher-power-ok";
					};

					qcom,batif@1200 {
						reg = <0x1200 0x100>;
						interrupts = <0x02 0x12 0x00 0x01 0x02 0x12 0x02 0x03 0x02 0x12 0x03 0x03 0x02 0x12 0x04 0x03 0x02 0x12 0x05 0x03 0x02 0x12 0x06 0x03 0x02 0x12 0x07 0x03>;
						interrupt-names = "bat-temp\0bat-ov\0bat-low\0bat-therm-or-id-missing\0bat-terminal-missing\0buck-oc\0vph-ov";
					};

					qcom,usb@1300 {
						reg = <0x1300 0x100>;
						interrupts = <0x02 0x13 0x00 0x03 0x02 0x13 0x01 0x03 0x02 0x13 0x02 0x03 0x02 0x13 0x03 0x03 0x02 0x13 0x04 0x03 0x02 0x13 0x05 0x03 0x02 0x13 0x06 0x01 0x02 0x13 0x07 0x01>;
						interrupt-names = "usbin-collapse\0usbin-vashdn\0usbin-uv\0usbin-ov\0usbin-plugin\0usbin-revi-change\0usbin-src-change\0usbin-icl-change";
					};

					qcom,dc@1400 {
						reg = <0x1400 0x100>;
						interrupts = <0x02 0x14 0x01 0x03 0x02 0x14 0x02 0x03 0x02 0x14 0x03 0x03 0x02 0x14 0x04 0x03 0x02 0x14 0x05 0x03 0x02 0x14 0x06 0x01 0x02 0x14 0x07 0x01>;
						interrupt-names = "dcin-vashdn\0dcin-uv\0dcin-ov\0dcin-plugin\0dcin-revi\0dcin-pon\0dcin-en";
					};

					qcom,typec@1500 {
						reg = <0x1500 0x100>;
						interrupts = <0x02 0x15 0x00 0x01 0x02 0x15 0x01 0x01 0x02 0x15 0x02 0x01 0x02 0x15 0x03 0x01 0x02 0x15 0x04 0x01 0x02 0x15 0x05 0x01 0x02 0x15 0x06 0x01 0x02 0x15 0x07 0x01>;
						interrupt-names = "typec-or-rid-detect-change\0typec-vpd-detect\0typec-cc-state-change\0typec-vconn-oc\0typec-vbus-change\0typec-attach-detach\0typec-legacy-cable-detect\0typec-try-snk-src-detect";
					};

					qcom,misc@1600 {
						reg = <0x1600 0x100>;
						interrupts = <0x02 0x16 0x00 0x01 0x02 0x16 0x01 0x01 0x02 0x16 0x02 0x01 0x02 0x16 0x03 0x01 0x02 0x16 0x04 0x03 0x02 0x16 0x05 0x01 0x02 0x16 0x06 0x01 0x02 0x16 0x07 0x01>;
						interrupt-names = "wdog-snarl\0wdog-bark\0aicl-fail\0aicl-done\0smb-en\0imp-trigger\0temp-change\0temp-change-smb";
					};

					qcom,chg-sdam@b000 {
						reg = <0xb000 0x100>;
					};

					smb5_vbus: qcom,smb5-vbus {
						regulator-name = "smb5-vbus";
					};

					smb5_vconn: qcom,smb5-vconn {
						regulator-name = "smb5-vconn";
					};
				};

				pm7250b_pdphy: qcom,usb-pdphy@1700 {
					compatible = "qcom,qpnp-pdphy";
					reg = <0x1700 0x100>;
					interrupts = <0x02 0x17 0x00 0x01 0x02 0x17 0x01 0x01 0x02 0x17 0x02 0x01 0x02 0x17 0x03 0x01 0x02 0x17 0x04 0x01 0x02 0x17 0x05 0x01 0x02 0x17 0x06 0x01 0x02 0x17 0x07 0x01>;
					interrupt-names = "sig-tx\0sig-rx\0msg-tx\0msg-rx\0msg-tx-failed\0msg-tx-discarded\0msg-rx-discarded\0fr-swap";
					qcom,default-sink-caps = <0x1388 0xbb8 0x2328 0xbb8 0x2ee0 0x8ca>;
					vdd-pdphy-supply = <&pm8150_l2>;
					vbus-supply = <&smb5_vbus>;
					vconn-supply = <&smb5_vconn>;
				};

				pm7250b_tz: qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400 0x100>;
					interrupts = <0x02 0x24 0x00 0x03>;
					io-channels = <&pm7250b_vadc 0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
				};

				pm7250b_qg: qpnp,qg {
					compatible = "qcom,qpnp-qg";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					qcom,vbatt-cutoff-mv = <0xc80>;
					qcom,vbatt-low-mv = <0xce4>;
					qcom,vbatt-low-cold-mv = <0xe74>;
					qcom,vbatt-empty-mv = <0xbb8>;
					qcom,vbatt-empty-cold-mv = <0xbb8>;
					qcom,s3-entry-fifo-length = <0x02>;
					qcom,pmic-revid = <&pm7250b_revid>;
					status = "ok";
					io-channels = <&pm7250b_vadc 0x4a &pm7250b_vadc 0x4b>;
					io-channel-names = "batt-therm\0batt-id";
					qcom,qg-iterm-ma = <0x64>;
					qcom,hold-soc-while-full;
					qcom,linearize-soc;
					qcom,cl-feedback-on;

					qcom,qgauge@4800 {
						status = "okay";
						reg = <0x4800 0x100>;
						interrupts = <0x02 0x48 0x00 0x03 0x02 0x48 0x01 0x03 0x02 0x48 0x02 0x01 0x02 0x48 0x03 0x01 0x02 0x48 0x04 0x01>;
						interrupt-names = "qg-batt-missing\0qg-vbat-low\0qg-vbat-empty\0qg-fifo-done\0qg-good-ocv";
					};

					qcom,qg-sdam@b100 {
						status = "okay";
						reg = <0xb100 0x100>;
					};
				};

				pm7250b_clkdiv: clock-controller@5b00 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x5b00 0x100>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x01>;
					clock-output-names = "pm7250b_div_clk1";
					clocks = <&rpmhcc 0x00>;
					clock-names = "xo";
					assigned-clocks = <&pm7250b_clkdiv 0x01>;
					assigned-clock-rates = <0x124f800>;
				};

				pm7250b_gpios: pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					reg = <0xc000 0xc00>;
					interrupts = <0x02 0xc0 0x00 0x00 0x02 0xc1 0x00 0x00 0x02 0xc2 0x00 0x00 0x02 0xc3 0x00 0x00 0x02 0xc4 0x00 0x00 0x02 0xc5 0x00 0x00 0x02 0xc6 0x00 0x00 0x02 0xc7 0x00 0x00 0x02 0xc8 0x00 0x00 0x02 0xc9 0x00 0x00 0x02 0xca 0x00 0x00 0x02 0xcb 0x00 0x00>;
					interrupt-names = "pm7250b_gpio1\0pm7250b_gpio2\0pm7250b_gpio3\0pm7250b_gpio4\0pm7250b_gpio5\0pm7250b_gpio6\0pm7250b_gpio7\0pm7250b_gpio8\0pm7250b_gpio9\0pm7250b_gpio10\0pm7250b_gpio11\0pm7250b_gpio12";
					gpio-controller;
					#gpio-cells = <0x02>;

					bmr_w_therm {

						bmr_w_therm_default: bmr_w_therm_default {
							pins = "gpio12";
							bias-high-impedance;
						};
					};

					camera_therm {

						camera_therm_default: camera_therm_default {
							pins = "gpio8";
							bias-high-impedance;
						};
					};
				};

				pm7250b_vadc: vadc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100 0x100>;
					reg-names = "adc5-usr-base";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x02 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					qcom,adc-vdd-reference = <0x753>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					pinctrl-names = "default";
					pinctrl-0 = <&bmr_w_therm_default &camera_therm_default>;

					ref_gnd@0 {
						reg = <0x00>;
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vref_1p25@1 {
						reg = <0x01>;
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					die_temp@2 {
						reg = <0x06>;
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vph_pwr@83 {
						reg = <0x83>;
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					vbat_sns@84 {
						reg = <0x84>;
						label = "vbat_sns";
						qcom,pre-scaling = <0x01 0x03>;
					};

					usb_in_i_uv@7 {
						reg = <0x07>;
						label = "usb_in_i_uv";
						qcom,pre-scaling = <0x01 0x01>;
					};

					usb_in_v_div_16@8 {
						reg = <0x08>;
						label = "usb_in_v_div_16";
						qcom,pre-scaling = <0x01 0x10>;
					};

					chg_temp@9 {
						reg = <0x09>;
						label = "chg_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					bat_therm@4a {
						reg = <0x4a>;
						label = "bat_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					bat_therm_30k@2a {
						reg = <0x2a>;
						label = "bat_therm_30k";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					bat_therm_400k@6a {
						reg = <0x6a>;
						label = "bat_therm_400k";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					bat_id@4b {
						reg = <0x4b>;
						label = "bat_id";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					smb1390_therm@e {
						reg = <0x0e>;
						label = "smb1390_therm";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					chg_sbux@99 {
						reg = <0x99>;
						label = "chg_sbux";
						qcom,pre-scaling = <0x01 0x03>;
					};

					mid_chg_div6@1e {
						reg = <0x1e>;
						label = "chg_mid";
						qcom,pre-scaling = <0x01 0x06>;
					};

					v_i_int_ext@b0 {
						reg = <0xb0>;
						label = "v_i_int_vbat_vdata";
						qcom,pre-scaling = <0x01 0x01>;
					};

					v_i_parallel@b0 {
						reg = <0xb4>;
						label = "v_i_parallel_vbat_vdata";
						qcom,pre-scaling = <0x01 0x01>;
					};

					charger_skin_therm@4d {
						reg = <0x4d>;
						label = "charger_skin_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					conn_therm@4f {
						reg = <0x4f>;
						label = "conn_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					bmr_w_therm@53 {
						reg = <0x53>;
						label = "bmr_w_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					camera_flash_therm@55 {
						reg = <0x55>;
						label = "camera_flash_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};
				};

				pm7250b_adc_tm: adc_tm@3500 {
					compatible = "qcom,adc-tm5";
					reg = <0x3500 0x100>;
					interrupts = <0x02 0x35 0x00 0x01>;
					interrupt-names = "thr-int-en";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					io-channels = <&pm7250b_vadc 0x4d &pm7250b_vadc 0x53 &pm7250b_vadc 0x55>;

					charger_skin_therm@4d {
						reg = <0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					bmr_w_therm@53 {
						reg = <0x53>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					camera_flash_therm@55 {
						reg = <0x55>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};

				pm7250b_bcl: bcl@1d00 {
					compatible = "qcom,bcl-v5";
					reg = <0x1d00 0x100>;
					interrupts = <0x02 0x1d 0x00 0x00 0x02 0x1d 0x01 0x00 0x02 0x1d 0x02 0x00>;
					interrupt-names = "bcl-lvl0\0bcl-lvl1\0bcl-lvl2";
					#thermal-sensor-cells = <0x01>;
				};

				bcl_soc: bcl-soc {
					compatible = "qcom,msm-bcl-soc";
					#thermal-sensor-cells = <0x00>;
				};
			};

			qcom,pm7250b@3 {
				compatible = "qcom,spmi-pmic";
				reg = <0x03 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				pm7250b_vib: qcom,vibrator@5300 {
					compatible = "qcom,qpnp-vibrator-ldo";
					reg = <0x5300 0x100>;
					qcom,vib-ldo-volt-uv = <0x1e8480>;
					qcom,disable-overdrive;
				};
			};
		};
	};

	fragment@10 {
		target = <&thermal_zones>;

		__overlay__ {

			pm7250b_temp_alarm: pm7250b-tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm7250b_tz>;
				wake-capable-sensor;

				trips {

					pm7250b_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
					};

					pm7250b_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
					};

					pm7250b_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
					};
				};
			};

			pm7250b-ibat-lvl0 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm7250b_bcl 0x00>;
				wake-capable-sensor;

				trips {

					ibat_lvl0: ibat-lvl0 {
						temperature = <0x157c>;
						hysteresis = <0xc8>;
						type = "passive";
					};
				};
			};

			pm7250b-ibat-lvl1 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm7250b_bcl 0x01>;
				wake-capable-sensor;

				trips {

					ibat_lvl1: ibat-lvl1 {
						temperature = <0x1770>;
						hysteresis = <0xc8>;
						type = "passive";
					};
				};
			};

			pm7250b-vbat-lvl0 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <&pm7250b_bcl 0x02>;
				wake-capable-sensor;
				tracks-low;

				trips {

					vbat_lvl0: vbat-lvl0 {
						temperature = <0xbb8>;
						hysteresis = <0xc8>;
						type = "passive";
					};
				};
			};

			pm7250b-vbat-lvl1 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <&pm7250b_bcl 0x03>;
				wake-capable-sensor;
				tracks-low;

				trips {

					vbat_lvl1: vbat-lvl1 {
						temperature = <0xaf0>;
						hysteresis = <0xc8>;
						type = "passive";
					};
				};
			};

			pm7250b-vbat-lvl2 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <&pm7250b_bcl 0x04>;
				wake-capable-sensor;
				tracks-low;

				trips {

					vbat_lvl2: vbat-lvl2 {
						temperature = <0xa28>;
						hysteresis = <0xc8>;
						type = "passive";
					};
				};
			};

			pm7250b-bcl-lvl0 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm7250b_bcl 0x05>;
				wake-capable-sensor;

				trips {

					b_bcl_lvl0: b-bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
					};
				};
			};

			pm7250b-bcl-lvl1 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm7250b_bcl 0x06>;
				wake-capable-sensor;

				trips {

					b_bcl_lvl1: b-bcl-lvl1 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
					};
				};
			};

			pm7250b-bcl-lvl2 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm7250b_bcl 0x07>;
				wake-capable-sensor;

				trips {

					b_bcl_lvl2: b-bcl-lvl2 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
					};
				};
			};

			soc {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <&bcl_soc>;
				wake-capable-sensor;
				tracks-low;

				trips {

					soc_trip: soc-trip {
						temperature = <0x0a>;
						hysteresis = <0x00>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@11 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8150l@4 {
				compatible = "qcom,spmi-pmic";
				reg = <0x04 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				pm8150l_revid: qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100 0x100>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
				};

				pm8150l_tz: qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400 0x100>;
					interrupts = <0x04 0x24 0x00 0x03>;
					io-channels = <&pm8150l_vadc 0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
				};

				pm8150l_clkdiv: clock-controller@5b00 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x5b00 0x100>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x01>;
					clock-output-names = "pm8150l_div_clk1";
					clocks = <&rpmhcc 0x00>;
					clock-names = "xo";
				};

				pm8150l_gpios: pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					reg = <0xc000 0xc00>;
					interrupts = <0x04 0xc0 0x00 0x00 0x04 0xc1 0x00 0x00 0x04 0xc2 0x00 0x00 0x04 0xc3 0x00 0x00 0x04 0xc4 0x00 0x00 0x04 0xc5 0x00 0x00 0x04 0xc6 0x00 0x00 0x04 0xc7 0x00 0x00 0x04 0xc8 0x00 0x00 0x04 0xc9 0x00 0x00 0x04 0xca 0x00 0x00 0x04 0xcb 0x00 0x00>;
					interrupt-names = "pm8150l_gpio1\0pm8150l_gpio2\0pm8150l_gpio3\0pm8150l_gpio4\0pm8150l_gpio5\0pm8150l_gpio6\0pm8150l_gpio7\0pm8150l_gpio8\0pm8150l_gpio9\0pm8150l_gpio10\0pm8150l_gpio11\0pm8150l_gpio12";
					gpio-controller;
					#gpio-cells = <0x02>;

					key_vol_up {

						key_vol_up_default: key_vol_up_default {
							pins = "gpio5";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x00>;
						};
					};

					eldo13_pin {

						usb_eldo13: gpio@cb00 {
							pins = "gpio12";
							function = "normal";
							qcom,drive-strength = <0x02>;
							power-source = <0x00>;
							bias-disable;
							output-high;
						};
					};

					disp_pins {

						disp_pins_default: disp_pins_default {
							pins = "gpio3";
							function = "func1";
							qcom,drive-strength = <0x02>;
							power-source = <0x00>;
							bias-disable;
							output-low;
						};
					};
				};

				pm8150l_vadc: vadc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100 0x100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x04 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					qcom,adc-vdd-reference = <0x753>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;

					ref_gnd@0 {
						reg = <0x00>;
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vref_1p25@1 {
						reg = <0x01>;
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					die_temp@2 {
						reg = <0x06>;
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vph_pwr@83 {
						reg = <0x83>;
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					pa_therm2@4d {
						reg = <0x4d>;
						label = "pa_therm2";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					msm_skin_therm@4e {
						reg = <0x4e>;
						label = "msm_skin_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					bmr_n_therm@4f {
						reg = <0x4f>;
						label = "bmr_n_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};
				};

				pm8150l_bcl: bcl@3d00 {
					compatible = "qcom,bcl-v5";
					reg = <0x3d00 0x100>;
					interrupts = <0x04 0x3d 0x00 0x00 0x04 0x3d 0x01 0x00 0x04 0x3d 0x02 0x00>;
					interrupt-names = "bcl-lvl0\0bcl-lvl1\0bcl-lvl2";
					#thermal-sensor-cells = <0x01>;
				};

				pm8150l_adc_tm: adc_tm@3500 {
					compatible = "qcom,adc-tm5";
					reg = <0x3500 0x100>;
					interrupts = <0x04 0x35 0x00 0x01>;
					interrupt-names = "thr-int-en";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					io-channels = <&pm8150l_vadc 0x4d &pm8150l_vadc 0x4e &pm8150l_vadc 0x4f>;

					pa_therm2@4d {
						reg = <0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					msm_skin_therm1@4e {
						reg = <0x4e>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					bmr_n_therm@4f {
						reg = <0x4f>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};
			};

			qcom,pm8150l@5 {
				compatible = "qcom,spmi-pmic";
				reg = <0x05 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				pm8150l_lcdb: qcom,lcdb@ec00 {
					compatible = "qcom,qpnp-lcdb-regulator";
					reg = <0xec00 0x100>;
					interrupts = <0x05 0xec 0x01 0x01>;
					interrupt-names = "sc-irq";
					qcom,pmic-revid = <&pm8150l_revid>;
					qcom,voltage-step-ramp;
					status = "disabled";

					lcdb_ldo_vreg: ldo {
						label = "ldo";
						regulator-name = "lcdb_ldo";
						regulator-min-microvolt = "\0=\t";
						regulator-max-microvolt = <0x5b8d80>;
					};

					lcdb_ncp_vreg: ncp {
						label = "ncp";
						regulator-name = "lcdb_ncp";
						regulator-min-microvolt = "\0=\t";
						regulator-max-microvolt = <0x5b8d80>;
					};

					lcdb_bst_vreg: bst {
						label = "bst";
						regulator-name = "lcdb_bst";
						regulator-min-microvolt = <0x47b760>;
						regulator-max-microvolt = <0x5fbfb8>;
					};
				};

				flash_led: qcom,leds@d300 {
					compatible = "qcom,qpnp-flash-led-v2";
					status = "okay";
					reg = <0xd300 0x100>;
					label = "flash";
					interrupts = <0x05 0xd3 0x00 0x01 0x05 0xd3 0x03 0x01 0x05 0xd3 0x04 0x01>;
					interrupt-names = "led-fault-irq\0all-ramp-down-done-irq\0all-ramp-up-done-irq";
					qcom,hdrm-auto-mode;
					qcom,short-circuit-det;
					qcom,open-circuit-det;
					qcom,vph-droop-det;
					qcom,thermal-derate-en;
					qcom,thermal-derate-current = <0xc8 0x1f4 0x3e8>;
					qcom,isc-delay = <0xc0>;
					qcom,pmic-revid = <&pm8150l_revid>;

					pm8150l_flash0: qcom,flash_0 {
						label = "flash";
						qcom,led-name = "led:flash_0";
						qcom,max-current = <0x5dc>;
						qcom,default-led-trigger = "flash0_trigger";
						qcom,id = <0x00>;
						qcom,current-ma = <0x3e8>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
					};

					pm8150l_flash1: qcom,flash_1 {
						label = "flash";
						qcom,led-name = "led:flash_1";
						qcom,max-current = <0x5dc>;
						qcom,default-led-trigger = "flash1_trigger";
						qcom,id = <0x01>;
						qcom,current-ma = <0x3e8>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
					};

					pm8150l_flash2: qcom,flash_2 {
						label = "flash";
						qcom,led-name = "led:flash_2";
						qcom,max-current = <0x2ee>;
						qcom,default-led-trigger = "flash2_trigger";
						qcom,id = <0x02>;
						qcom,current-ma = <0x1f4>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						status = "disabled";
					};

					pm8150l_torch0: qcom,torch_0 {
						label = "torch";
						qcom,led-name = "led:torch_0";
						qcom,max-current = <0x1f4>;
						qcom,default-led-trigger = "torch0_trigger";
						qcom,id = <0x00>;
						qcom,current-ma = <0x12c>;
						qcom,ires-ua = <0x30d4>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
					};

					pm8150l_torch1: qcom,torch_1 {
						label = "torch";
						qcom,led-name = "led:torch_1";
						qcom,max-current = <0x1f4>;
						qcom,default-led-trigger = "torch1_trigger";
						qcom,id = <0x01>;
						qcom,current-ma = <0x12c>;
						qcom,ires-ua = <0x30d4>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
					};

					pm8150l_torch2: qcom,torch_2 {
						label = "torch";
						qcom,led-name = "led:torch_2";
						qcom,max-current = <0x1f4>;
						qcom,default-led-trigger = "torch2_trigger";
						qcom,id = <0x02>;
						qcom,current-ma = <0x12c>;
						qcom,ires-ua = <0x30d4>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						status = "disabled";
					};

					pm8150l_switch0: qcom,led_switch_0 {
						label = "switch";
						qcom,led-name = "led:switch_0";
						qcom,led-mask = <0x01>;
						qcom,default-led-trigger = "switch0_trigger";
					};

					pm8150l_switch1: qcom,led_switch_1 {
						label = "switch";
						qcom,led-name = "led:switch_1";
						qcom,led-mask = <0x02>;
						qcom,default-led-trigger = "switch1_trigger";
					};

					pm8150l_switch2: qcom,led_switch_2 {
						label = "switch";
						qcom,led-name = "led:switch_2";
						qcom,led-mask = <0x03>;
						qcom,default-led-trigger = "switch2_trigger";
					};

					pm8150l_switch3: qcom,led_switch_3 {
						label = "switch";
						qcom,led-name = "led:switch_3";
						qcom,led-mask = <0x04>;
						qcom,default-led-trigger = "switch3_trigger";
					};
				};

				pm8150l_wled: qcom,wled@d800 {
					compatible = "qcom,pm8150l-spmi-wled";
					reg = <0xd800 0x100 0xd900 0x100>;
					reg-names = "wled-ctrl-base\0wled-sink-base";
					label = "backlight";
					interrupts = <0x05 0xd8 0x01 0x01 0x05 0xd8 0x04 0x03 0x05 0xd8 0x05 0x03>;
					interrupt-names = "ovp-irq\0pre-flash-irq\0flash-irq";
					qcom,pmic-revid = <&pm8150l_revid>;
					qcom,auto-calibration;
					status = "disabled";

					wled_flash: qcom,wled-flash {
						label = "flash";
						qcom,default-led-trigger = "wled_flash";
					};

					wled_torch: qcom,wled-torch {
						label = "torch";
						qcom,default-led-trigger = "wled_torch";
						qcom,wled-torch-timer = <0x4b0>;
					};

					wled_switch: qcom,wled-switch {
						label = "switch";
						qcom,default-led-trigger = "wled_switch";
					};
				};

				pm8150l_lpg: qcom,pwms@b100 {
					compatible = "qcom,pwm-lpg";
					reg = <0xb100 0x300 0xb000 0x100>;
					reg-names = "lpg-base\0lut-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x03>;
					qcom,lut-patterns = <0x00 0x0a 0x14 0x1e 0x28 0x32 0x3c 0x46 0x50 0x5a 0x64 0x5a 0x50 0x46 0x3c 0x32 0x28 0x1e 0x14 0x0a 0x00>;

					lpg1 {
						qcom,lpg-chan-id = <0x01>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-pause-hi-count = <0x02>;
						qcom,ramp-pause-lo-count = <0x02>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x14>;
						qcom,ramp-from-low-to-high;
						qcom,ramp-pattern-repeat;
					};

					lpg2 {
						qcom,lpg-chan-id = <0x02>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-pause-hi-count = <0x02>;
						qcom,ramp-pause-lo-count = <0x02>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x14>;
						qcom,ramp-from-low-to-high;
						qcom,ramp-pattern-repeat;
					};

					lpg3 {
						qcom,lpg-chan-id = <0x03>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-pause-hi-count = <0x02>;
						qcom,ramp-pause-lo-count = <0x02>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x14>;
						qcom,ramp-from-low-to-high;
						qcom,ramp-pattern-repeat;
					};
				};

				pm8150l_pwm: qcom,pwms@bc00 {
					compatible = "qcom,pwm-lpg";
					reg = <0xbc00 0x200>;
					reg-names = "lpg-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x02>;
				};

				pm8150l_rgb_led: qcom,leds@d000 {
					compatible = "qcom,tri-led";
					reg = <0xd000 0x100>;

					red {
						label = "red";
						pwms = <&pm8150l_lpg 0x00 0xf4240>;
						led-sources = <0x00>;
						linux,default-trigger = "timer";
					};

					green {
						label = "green";
						pwms = <&pm8150l_lpg 0x01 0xf4240>;
						led-sources = <0x01>;
						linux,default-trigger = "timer";
					};

					blue {
						label = "blue";
						pwms = <&pm8150l_lpg 0x02 0xf4240>;
						led-sources = <0x02>;
						linux,default-trigger = "timer";
					};
				};

				pm8150a_amoled: qcom,amoled {
					compatible = "qcom,qpnp-amoled-regulator";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					status = "ok";

					oledb_vreg: oledb@e000 {
						reg = <0xe000 0x100>;
						reg-names = "oledb_base";
						regulator-name = "oledb";
						regulator-min-microvolt = <0x4b2648>;
						regulator-max-microvolt = <0x7b98a0>;
						qcom,swire-control;
					};

					ab_vreg: ab@de00 {
						reg = <0xde00 0x100>;
						reg-names = "ab_base";
						regulator-name = "ab";
						regulator-min-microvolt = <0x4630c0>;
						regulator-max-microvolt = <0x5d1420>;
						qcom,swire-control;
					};

					ibb_vreg: ibb@dc00 {
						reg = <0xdc00 0x100>;
						reg-names = "ibb_base";
						regulator-name = "ibb";
						regulator-min-microvolt = [00 0c 35 00];
						regulator-max-microvolt = <0x5265c0>;
						qcom,swire-control;
					};
				};
			};
		};
	};

	fragment@12 {
		target = <&thermal_zones>;

		__overlay__ {

			pm8150l_temp_alarm: pm8150l_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150l_tz>;
				wake-capable-sensor;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
					};

					trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
					};
				};
			};

			pm8150l-vph-lvl0 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <&pm8150l_bcl 0x02>;
				tracks-low;
				wake-capable-sensor;

				trips {

					vph_lvl0: vph-lvl0 {
						temperature = <0xbb8>;
						hysteresis = <0xc8>;
						type = "passive";
					};
				};
			};

			pm8150l-vph-lvl1 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <&pm8150l_bcl 0x03>;
				tracks-low;
				wake-capable-sensor;

				trips {

					vph_lvl1: vph-lvl1 {
						temperature = <0xabe>;
						hysteresis = <0xc8>;
						type = "passive";
					};
				};
			};

			pm8150l-vph-lvl2 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <&pm8150l_bcl 0x04>;
				tracks-low;
				wake-capable-sensor;

				trips {

					vph_lvl2: vph-lvl2 {
						temperature = <0x9c4>;
						hysteresis = <0xc8>;
						type = "passive";
					};
				};
			};

			pm8150l-bcl-lvl0 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150l_bcl 0x05>;
				wake-capable-sensor;

				trips {

					l_bcl_lvl0: l-bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
					};
				};
			};

			pm8150l-bcl-lvl1 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150l_bcl 0x06>;
				wake-capable-sensor;

				trips {

					l_bcl_lvl1: l-bcl-lvl1 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
					};
				};
			};

			pm8150l-bcl-lvl2 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150l_bcl 0x07>;
				wake-capable-sensor;

				trips {

					l_bcl_lvl2: l-bcl-lvl2 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@13 {
		target = <&thermal_zones>;

		__overlay__ {

			charger-therm-usr {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "user_space";
				thermal-sensors = <&pm7250b_adc_tm 0x4d>;
				wake-capable-sensor;

				trips {

					active-config0 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			camera-therm-usr {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "user_space";
				thermal-sensors = <&pm7250b_adc_tm 0x55>;
				wake-capable-sensor;

				trips {

					active-config0 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			xo-therm-usr {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "user_space";
				thermal-sensors = <&pm8150_adc_tm 0x4c>;
				wake-capable-sensor;

				trips {

					active-config0 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			pa-therm2-usr {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "user_space";
				thermal-sensors = <&pm8150l_adc_tm 0x4d>;
				wake-capable-sensor;

				trips {

					active-config0 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			msm-s-therm-usr {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "user_space";
				thermal-sensors = <&pm8150l_adc_tm 0x4e>;
				wake-capable-sensor;

				trips {

					active-config0 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@14 {
		target = <&usb0>;

		__overlay__ {
			extcon = <&pm7250b_pdphy &pm7250b_charger &eud>;
		};
	};

	fragment@15 {
		target = <&usb_qmp_dp_phy>;

		__overlay__ {
			extcon = <&pm7250b_pdphy>;
		};
	};

	fragment@16 {
		target = <&mdss_mdp>;

		__overlay__ {

			dsi_sw43404_amoled_cmd: qcom,mdss_dsi_sw43404_amoled_wqhd_cmd {
				qcom,mdss-dsi-panel-name = "sw43404 amoled cmd mode dsi boe panel with DSC";
				qcom,mdss-dsi-panel-type = "dsi_cmd_mode";
				qcom,mdss-dsi-panel-physical-type = "oled";
				qcom,mdss-dsi-virtual-channel-id = <0x00>;
				qcom,mdss-dsi-stream = <0x00>;
				qcom,mdss-dsi-bpp = <0x18>;
				qcom,mdss-dsi-color-order = "rgb_swap_rgb";
				qcom,mdss-dsi-underflow-color = <0xff>;
				qcom,mdss-dsi-border-color = <0x00>;
				qcom,dsi-ctrl-num = <0x00>;
				qcom,dsi-phy-num = <0x00>;
				qcom,mdss-dsi-traffic-mode = "non_burst_sync_event";
				qcom,mdss-dsi-lane-map = "lane_map_0123";
				qcom,mdss-dsi-bllp-eof-power-mode;
