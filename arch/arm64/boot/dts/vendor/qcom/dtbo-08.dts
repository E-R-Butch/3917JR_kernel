					lpi_i2s2_sd1_active: lpi_i2s2_sd1_active {

						mux {
							pins = "gpio13";
							function = "func2";
						};

						config {
							pins = "gpio13";
							drive-strength = <0x08>;
							bias-disable;
							output-high;
						};
					};
				};

				quat_tdm_sck {

					quat_tdm_sck_sleep: quat_tdm_sck_sleep {

						mux {
							pins = "gpio0";
							function = "func2";
						};

						config {
							pins = "gpio0";
							drive-strength = <0x02>;
