						trip = <&mmw_pa3_trip2>;
						cooling-device = <&modem_mmw_skin0 0x03 0x03>;
					};
				};
			};

			mmw-pa2-step {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm7250b_adc_tm 0x53>;
				wake-capable-sensor;

				trips {

					mmw_pa2_trip0: mmw-pa2-trip0 {
						temperature = <0xa7f8>;
						hysteresis = <0xbb8>;
