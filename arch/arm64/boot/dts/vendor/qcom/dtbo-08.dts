							input-enable;
						};
					};

					quat_tdm_sck_active: quat_tdm_sck_active {

						mux {
							pins = "gpio0";
							function = "func2";
						};

						config {
							pins = "gpio0";
							drive-strength = <0x08>;
							bias-disable;
							output-high;
						};
