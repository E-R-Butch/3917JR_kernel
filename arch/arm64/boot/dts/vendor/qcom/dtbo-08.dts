						mux {
							pins = "gpio10";
							function = "func1";
						};

						config {
							pins = "gpio10";
							drive-strength = <0x02>;
							bias-pull-down;
							input-enable;
						};
					};

					lpi_i2s2_sck_active: lpi_i2s2_sck_active {

						mux {
							pins = "gpio10";
							function = "func1";
						};

						config {
							pins = "gpio10";
							drive-strength = <0x08>;
							bias-disable;
							output-high;
