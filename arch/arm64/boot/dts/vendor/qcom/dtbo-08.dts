						hysteresis = <0xfa0>;
						type = "passive";
					};
				};

				cooling-maps {

					skin_cpu7 {
						trip = <&gold_plus_trip>;
						cooling-device = <&CPU7 0xffffffff 0xfffffffb>;
					};

					skin_cpu6 {
						trip = <&gold_trip>;
						cooling-device = <&CPU6 0xffffffff 0xfffffffb>;
					};

					skin_cpu0 {
						trip = <&silver_trip>;
						cooling-device = <&CPU0 0xffffffff 0xfffffff9>;
					};

					skin_gpu {
						trip = <&gpu_modem2_skin_trip>;
						cooling-device = <&msm_gpu 0xfffffffd 0xfffffffd>;
					};

					skin_modem_pa1 {
						trip = <&modem0_skin_trip>;
						cooling-device = <&modem_pa 0x01 0x01>;
					};

					skin_modem_pa2 {
						trip = <&modem1_skin_trip>;
						cooling-device = <&modem_pa 0x02 0x02>;
					};

					skin_modem_pa3 {
						trip = <&gpu_modem2_skin_trip>;
						cooling-device = <&modem_pa 0x03 0x03>;
					};

					skin_modem_pa_fr1_1 {
						trip = <&modem0_skin_trip>;
						cooling-device = <&modem_pa_fr1 0x01 0x01>;
					};

					skin_modem_pa_fr1_2 {
						trip = <&modem1_skin_trip>;
						cooling-device = <&modem_pa_fr1 0x02 0x02>;
					};

					skin_modem_pa_fr1_3 {
						trip = <&gpu_modem2_skin_trip>;
						cooling-device = <&modem_pa_fr1 0x03 0x03>;
					};

					skin_cdsp {
						trip = <&cx_emer_trip>;
						cooling-device = <&msm_cdsp_rm 0x03 0x03>;
					};

					skin_npu {
						trip = <&cx_emer_trip>;
						cooling-device = <&msm_npu 0xfffffffe 0xfffffffe>;
					};

					skin_batt_cdev0 {
						trip = <&skin_batt_trip0>;
						cooling-device = <&pm7250b_charger 0x01 0x01>;
