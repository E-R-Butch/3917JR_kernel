						temperature = <0xc350>;
						hysteresis = <0x00>;
						type = "passive";
					};

					modem1_skin_trip: modem1-skin-trip {
						temperature = <0xcb20>;
						hysteresis = <0xfa0>;
						type = "passive";
					};

					skin_batt_trip4: skin-batt-trip4 {
						temperature = <0xcb20>;
						hysteresis = <0x7d0>;
						type = "passive";
					};

					gold_trip: gold-trip {
						temperature = <0xcb20>;
						hysteresis = <0x00>;
						type = "passive";
					};

					cx_emer_trip: cx-emer-trip {
						temperature = <0xd2f0>;
						hysteresis = <0x1770>;
						type = "passive";
