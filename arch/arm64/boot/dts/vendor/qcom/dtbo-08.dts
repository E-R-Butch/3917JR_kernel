	fragment@16 {
		target = <&mdss_mdp>;

		__overlay__ {
			#cooling-cells = <0x02>;
		};
	};

	fragment@17 {
		target = <&thermal_zones>;

		__overlay__ {

			pm7250b-tz {

				cooling-maps {

					trip0_bat {
