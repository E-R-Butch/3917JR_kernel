					};
				};
			};

			vdda_usb_ss_dp_core: vdda_usb_ss_dp_core {
				compatible = "regulator-fixed";
				regulator-name = "vdd_supply";
				regulator-min-microvolt = <0xd6d80>;
				regulator-max-microvolt = <0xd6d80>;
				enable-active-high;
				gpio = <&pm8150l_gpios 0x0c 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&usb_eldo13>;
			};
		};
	};

	fragment@51 {
		target = <&usb_qmp_dp_phy>;

		__overlay__ {
			vdd-supply = <&vdda_usb_ss_dp_core>;
		};
	};

	fragment@52 {
		target = <&usb2_phy0>;

		__overlay__ {
			qcom,param-override-seq = <0x63 0x6c 0xc8 0x70 0x17 0x74>;
		};
	};

	fragment@53 {
		target = <&sde_dp>;

		__overlay__ {
			vdda-0p9-supply = <&vdda_usb_ss_dp_core>;
		};
	};

	fragment@54 {
		target = <&qupv3_se7_i2c>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "ok";
			qcom,i2c-touch-active = "focaltech,fts";

			focaltech@38 {
				compatible = "focaltech,fts";
				reg = <0x38>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x09 0x2008>;
				focaltech,reset-gpio = <&tlmm 0x08 0x01>;
				focaltech,irq-gpio = <&tlmm 0x09 0x02>;
				focaltech,max-touch-number = <0x0a>;
				focaltech,display-coords = <0x00 0x00 0x438 0x924>;
				pinctrl-names = "pmx_ts_active\0pmx_ts_suspend";
				pinctrl-0 = <&ts_active>;
				pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
				panel = <&dsi_ft8719_lead_video &dsi_ft8719_equick_video>;
			};

			st_fts@49 {
				compatible = "st,fts";
				reg = <0x49>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x09 0x2008>;
				vdd-supply = <&pm8150_s4>;
				avdd-supply = <&pm8150_l13>;
				pinctrl-names = "pmx_ts_active\0pmx_ts_suspend";
				pinctrl-0 = <&ts_active>;
				pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
				st,irq-gpio = <&tlmm 0x09 0x2008>;
				st,reset-gpio = <&tlmm 0x08 0x00>;
				st,regulator_dvdd = "vdd";
				st,regulator_avdd = "avdd";
				st,x-flip;
				st,y-flip;
				st,power_on_suspend;
				panel = <&dsi_sw43404_amoled_cmd &dsi_sw43404_amoled_video &dsi_sw43404_amoled_fhd_plus_cmd>;
			};
		};
	};

	fragment@55 {
		target = <&tlmm>;

		__overlay__ {

			pmx_ts_active {

				ts_active: ts_active {

					mux {
						pins = "gpio8\0gpio9";
						function = "gpio";
					};

					config {
						pins = "gpio8\0gpio9";
						drive-strength = <0x08>;
						bias-pull-up;
					};
				};
			};

			pmx_ts_int_suspend {

				ts_int_suspend: ts_int_suspend {

					mux {
						pins = "gpio9";
						function = "gpio";
					};

					config {
						pins = "gpio9";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};

			pmx_ts_reset_suspend {

				ts_reset_suspend: ts_reset_suspend {

					mux {
						pins = "gpio8";
						function = "gpio";
					};

					config {
						pins = "gpio8";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};
		};
	};

	fragment@56 {
		target = <&ufsphy_mem>;

		__overlay__ {
			compatible = "qcom,ufs-phy-qmp-v4-lito";
			vdda-phy-supply = <&pm8150_l5>;
			vdda-pll-supply = <&pm8150_l9>;
			vdda-phy-max-microamp = <0x16058>;
			vdda-pll-max-microamp = <0x4a38>;
			status = "ok";
		};
	};

	fragment@57 {
		target = <&ufshc_mem>;

		__overlay__ {
			vdd-hba-supply = <&ufs_phy_gdsc>;
			vdd-hba-fixed-regulator;
			vcc-supply = <&pm8150a_l7>;
			vcc-voltage-level = <0x2d0370 0x2d2a80>;
			vccq2-supply = <&pm8150_s4>;
			vcc-max-microamp = [00 0c 35 00];
			vccq2-max-microamp = [00 0c 35 00];
			qcom,vddp-ref-clk-supply = <&pm8150_l9>;
			qcom,vddp-ref-clk-max-microamp = <0x64>;
			qcom,vddp-ref-clk-min-uV = <0x119400>;
			qcom,vddp-ref-clk-max-uV = <0x124f80>;
			status = "ok";
		};
	};

	fragment@58 {
		target = <&sdhc_1>;

		__overlay__ {
			vdd-supply = <&pm8150a_l7>;
			qcom,vdd-voltage-level = <0x2d0370 0x2d0370>;
			qcom,vdd-current-level = <0x00 0x8b290>;
			vdd-io-supply = <&pm8150_s4>;
			qcom,vdd-io-always-on;
			qcom,vdd-io-lpm-sup;
			qcom,vdd-io-voltage-level = <0x1b7740 0x1b7740>;
			qcom,vdd-io-current-level = <0x00 0x4f588>;
			pinctrl-names = "active\0sleep";
			pinctrl-0 = <&sdc1_clk_on &sdc1_cmd_on &sdc1_data_on &sdc1_rclk_on>;
			pinctrl-1 = <&sdc1_clk_off &sdc1_cmd_off &sdc1_data_off &sdc1_rclk_off>;
			status = "ok";
		};
	};

	fragment@59 {
		target = <&sdhc_2>;

		__overlay__ {
			vdd-supply = <&pm8150a_l9>;
			qcom,vdd-voltage-level = <0x2d0370 0x2d0370>;
			qcom,vdd-current-level = <0x00 0xc3500>;
			vdd-io-supply = <&pm8150a_l6>;
			qcom,vdd-io-voltage-level = <0x1b7740 0x2d0370>;
			qcom,vdd-io-current-level = <0x00 0x55f0>;
			pinctrl-names = "active\0sleep";
			pinctrl-0 = <&sdc2_clk_on &sdc2_cmd_on &sdc2_data_on &sdc2_cd_on>;
			pinctrl-1 = <&sdc2_clk_off &sdc2_cmd_off &sdc2_data_off &sdc2_cd_off>;
			cd-gpios = <&tlmm 0x45 0x00>;
			status = "ok";
		};
	};

	fragment@60 {
		target = <&pm8008_8>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@61 {
		target = <&thermal_zones>;

		__overlay__ {

			conn-therm-usr {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "user_space";
				thermal-sensors = <&pm7250b_adc_tm 0x4f>;
				wake-capable-sensor;

				trips {

					active-config0 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			xo-therm-step {
				polling-delay-passive = <0x7d0>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8150_adc_tm 0x4c>;
				wake-capable-sensor;

				trips {

					skin_batt_trip0: skin-batt-trip0 {
						temperature = <0xa410>;
						hysteresis = <0x7d0>;
						type = "passive";
					};

					skin_batt_trip1: skin-batt-trip1 {
						temperature = <0xabe0>;
						hysteresis = <0x7d0>;
						type = "passive";
					};

					skin_batt_trip2: skin-batt-trip2 {
						temperature = <0xbb80>;
						hysteresis = <0xfa0>;
						type = "passive";
					};

