					qcom,supply-max-voltage = <0x5b8d80>;
					qcom,supply-enable-load = <0x186a0>;
					qcom,supply-disable-load = <0x64>;
					qcom,supply-post-on-sleep = <0x14>;
				};
			};

			sde_dsi: qcom,dsi-display-primary {
				compatible = "qcom,dsi-display";
				label = "primary";
				qcom,dsi-ctrl = <&mdss_dsi0 &mdss_dsi1>;
				qcom,dsi-phy = <&mdss_dsi_phy0 &mdss_dsi_phy1>;
				clocks = <&mdss_dsi0_pll 0x06 &mdss_dsi0_pll 0x09 &mdss_dsi0_pll 0x03 &mdss_dsi0_pll 0x08 &mdss_dsi0_pll 0x0d &mdss_dsi0_pll 0x11 &mdss_dsi1_pll 0x20 &mdss_dsi1_pll 0x23 &mdss_dsi1_pll 0x1d &mdss_dsi1_pll 0x22 &mdss_dsi1_pll 0x27 &mdss_dsi1_pll 0x2b &rpmhcc 0x04>;
				clock-names = "mux_byte_clk0\0mux_pixel_clk0\0src_byte_clk0\0src_pixel_clk0\0shadow_byte_clk0\0shadow_pixel_clk0\0mux_byte_clk1\0mux_pixel_clk1\0src_byte_clk1\0src_pixel_clk1\0shadow_byte_clk1\0shadow_pixel_clk1\0bb_clk2";
				pinctrl-names = "panel_active\0panel_suspend";
				pinctrl-0 = <&sde_te_active &disp_pins_default>;
				pinctrl-1 = <&sde_te_suspend>;
				qcom,platform-te-gpio = <&tlmm 0x0a 0x00>;
				qcom,panel-te-source = <0x00>;
				vddio-supply = <&L1C>;
				vdd-supply = <&L16A>;
				qcom,mdp = <&mdss_mdp>;
				qcom,dsi-default-panel = <&dsi_ft8719_lead_video>;
				lab-supply = <&lcdb_ldo_vreg>;
				ibb-supply = <&lcdb_ncp_vreg>;
			};

			sde_dsi1: qcom,dsi-display-secondary {
				compatible = "qcom,dsi-display";
				label = "secondary";
				qcom,dsi-ctrl = <&mdss_dsi0 &mdss_dsi1>;
				qcom,dsi-phy = <&mdss_dsi_phy0 &mdss_dsi_phy1>;
				clocks = <&mdss_dsi0_pll 0x06 &mdss_dsi0_pll 0x09 &mdss_dsi1_pll 0x20 &mdss_dsi1_pll 0x23>;
				clock-names = "mux_byte_clk0\0mux_pixel_clk0\0mux_byte_clk1\0mux_pixel_clk1";
				pinctrl-names = "panel_active\0panel_suspend";
				pinctrl-0 = <&sde_te1_active>;
				pinctrl-1 = <&sde_te1_suspend>;
				qcom,platform-te-gpio = <&tlmm 0x0b 0x00>;
				qcom,panel-te-source = <0x01>;
				vddio-supply = <&L1C>;
				vdd-supply = <&L16A>;
				qcom,mdp = <&mdss_mdp>;
			};

			sde_wb: qcom,wb-display@0 {
				compatible = "qcom,wb-display";
				cell-index = <0x00>;
				label = "wb_display";
			};

			msm_notifier: qcom,msm_notifier@0 {
				compatible = "qcom,msm-notifier";
				panel = <&dsi_sw43404_amoled_cmd &dsi_sharp_qsync_wqhd_cmd &dsi_dual_sim_dsc_375_cmd &dsi_sw43404_amoled_video &dsi_sharp_qsync_wqhd_video &dsi_sharp_qsync_fhd_cmd &dsi_sharp_qsync_fhd_video &dsi_rm692a9_visionox_amoled_cmd &dsi_old_rm692a9_visionox_amoled_cmd>;
			};
		};
	};

	fragment@48 {
		target = <&sde_dp>;

		__overlay__ {
			qcom,dp-usbpd-detection = <&pm7250b_pdphy>;
			qcom,ext-disp = <&ext_disp>;
			qcom,dp-aux-switch = <&fsa4480>;
			qcom,usbplug-cc-gpio = <&tlmm 0x72 0x00>;
			pinctrl-names = "mdss_dp_active\0mdss_dp_sleep";
			pinctrl-0 = <&sde_dp_usbplug_cc_active>;
			pinctrl-1 = <&sde_dp_usbplug_cc_suspend>;
		};
	};

	fragment@49 {
		target = <&mdss_mdp>;

		__overlay__ {
			connectors = <&sde_wb &sde_dsi &sde_dsi1 &sde_dp &sde_rscc>;
		};
	};

