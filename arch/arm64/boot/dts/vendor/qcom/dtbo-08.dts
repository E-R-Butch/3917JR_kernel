						hysteresis = <0xfa0>;
						type = "passive";
					};

					skin_msm_trip1: skin-msm-trip1 {
						temperature = <0xdac0>;
						hysteresis = <0xfa0>;
						type = "passive";
					};
				};

				cooling-maps {

					mdm_skin_cdev0 {
						trip = <&skin_msm_trip0>;
						cooling-device = <&modem_tj 0x01 0x01>;
					};

					mdm_skin_cdev1 {
						trip = <&skin_msm_trip1>;
						cooling-device = <&modem_tj 0x03 0x03>;
					};
				};
			};
		};
	};

	fragment@62 {
		target = <&lito_snd>;

		__overlay__ {
			qcom,model = "lito-qrd-snd-card";
			qcom,audio-routing = "AMIC2\0MIC BIAS2\0MIC BIAS2\0Analog Mic2\0TX DMIC0\0MIC BIAS3\0MIC BIAS3\0Digital Mic0\0TX DMIC1\0MIC BIAS3\0MIC BIAS3\0Digital Mic1\0TX DMIC2\0MIC BIAS1\0MIC BIAS1\0Digital Mic2\0TX DMIC3\0MIC BIAS1\0MIC BIAS1\0Digital Mic3\0TX DMIC4\0MIC BIAS4\0MIC BIAS4\0Digital Mic4\0TX DMIC5\0MIC BIAS4\0MIC BIAS4\0Digital Mic5\0IN1_HPHL\0HPHL_OUT\0IN2_HPHR\0HPHR_OUT\0IN3_AUX\0AUX_OUT\0TX SWR_ADC0\0ADC1_OUTPUT\0TX SWR_ADC1\0ADC2_OUTPUT\0TX SWR_ADC2\0ADC3_OUTPUT\0TX SWR_ADC3\0ADC4_OUTPUT\0TX SWR_DMIC0\0DMIC1_OUTPUT\0TX SWR_DMIC1\0DMIC2_OUTPUT\0TX SWR_DMIC2\0DMIC3_OUTPUT\0TX SWR_DMIC3\0DMIC4_OUTPUT\0TX SWR_DMIC4\0DMIC5_OUTPUT\0TX SWR_DMIC5\0DMIC6_OUTPUT\0TX SWR_DMIC6\0DMIC7_OUTPUT\0TX SWR_DMIC7\0DMIC8_OUTPUT\0WSA SRC0_INP\0SRC0\0WSA_TX DEC0_INP\0TX DEC0 MUX\0WSA_TX DEC1_INP\0TX DEC1 MUX\0RX_TX DEC0_INP\0TX DEC0 MUX\0RX_TX DEC1_INP\0TX DEC1 MUX\0RX_TX DEC2_INP\0TX DEC2 MUX\0RX_TX DEC3_INP\0TX DEC3 MUX\0SpkrRight IN\0WSA_SPK2 OUT\0VA_AIF1 CAP\0VA_SWR_CLK\0VA_AIF2 CAP\0VA_SWR_CLK\0VA_AIF3 CAP\0VA_SWR_CLK\0VA MIC BIAS3\0Digital Mic0\0VA MIC BIAS3\0Digital Mic1\0VA MIC BIAS1\0Digital Mic2\0VA MIC BIAS1\0Digital Mic3\0VA MIC BIAS4\0Digital Mic4\0VA MIC BIAS4\0Digital Mic5\0VA DMIC0\0VA MIC BIAS3\0VA DMIC1\0VA MIC BIAS3\0VA DMIC2\0VA MIC BIAS1\0VA DMIC3\0VA MIC BIAS1\0VA DMIC4\0VA MIC BIAS4\0VA DMIC5\0VA MIC BIAS4\0VA SWR_ADC0\0VA_SWR_CLK\0VA SWR_ADC1\0VA_SWR_CLK\0VA SWR_ADC2\0VA_SWR_CLK\0VA SWR_ADC3\0VA_SWR_CLK\0VA SWR_MIC0\0VA_SWR_CLK\0VA SWR_MIC1\0VA_SWR_CLK\0VA SWR_MIC2\0VA_SWR_CLK\0VA SWR_MIC3\0VA_SWR_CLK\0VA SWR_MIC4\0VA_SWR_CLK\0VA SWR_MIC5\0VA_SWR_CLK\0VA SWR_MIC6\0VA_SWR_CLK\0VA SWR_MIC7\0VA_SWR_CLK\0VA SWR_ADC1\0ADC2_OUTPUT\0VA SWR_MIC0\0DMIC1_OUTPUT\0VA SWR_MIC1\0DMIC2_OUTPUT\0VA SWR_MIC0\0DMIC1_OUTPUT\0VA SWR_MIC1\0DMIC2_OUTPUT\0VA SWR_MIC2\0DMIC3_OUTPUT\0VA SWR_MIC3\0DMIC4_OUTPUT\0VA SWR_MIC4\0DMIC5_OUTPUT\0VA SWR_MIC5\0DMIC6_OUTPUT\0VA SWR_MIC6\0DMIC7_OUTPUT\0VA SWR_MIC7\0DMIC8_OUTPUT";
			qcom,wsa-max-devs = <0x00>;
			qcom,wsa-aux-dev-prefix = "SpkrRight\0SpkrRight";
			qcom,msm-mbhc-usbc-audio-supported = <0x01>;
			qcom,msm-mbhc-hphl-swh = <0x01>;
			qcom,msm-mbhc-gnd-swh = <0x01>;
		};
	};

	fragment@63 {
		target = <&qupv3_se0_i2c>;

		__overlay__ {
			status = "ok";
			qcom,clk-freq-out = <0xf4240>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			nq@28 {
				compatible = "qcom,nq-nci";
				reg = <0x28>;
				qcom,nq-irq = <&tlmm 0x22 0x00>;
				qcom,nq-ven = <&tlmm 0x0c 0x00>;
				qcom,nq-firm = <&tlmm 0x23 0x00>;
				qcom,nq-clkreq = <&tlmm 0x1f 0x00>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x22 0x00>;
				interrupt-names = "nfc_irq";
				pinctrl-names = "nfc_active\0nfc_suspend";
				pinctrl-0 = <&nfc_int_active &nfc_enable_active &nfc_clk_req_active>;
				pinctrl-1 = <&nfc_int_suspend &nfc_enable_suspend &nfc_clk_req_suspend>;
			};
		};
	};

	fragment@64 {
		target = <&qupv3_se9_i2c>;

		__overlay__ {
			status = "ok";

			smb1390: qcom,smb1390@10 {
				compatible = "qcom,i2c-pmic";
				reg = <0x10>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				interrupt-parent = <&spmi_bus>;
				interrupts = <0x02 0xc5 0x00 0x08>;
				interrupt_names = "smb1390";
				interrupt-controller;
				#interrupt-cells = <0x03>;
				qcom,periph-map = <0x10>;
				status = "ok";
				pinctrl-names = "default";
				pinctrl-0 = <&smb_stat_default>;

				smb1390_revid: qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100>;
				};

				smb1390_charger: qcom,charge_pump {
					compatible = "qcom,smb1390-charger-psy";
					qcom,pmic-revid = <&smb1390_revid>;
					interrupt-parent = <&smb1390>;
					status = "ok";
					io-channels = <&pm7250b_vadc 0x0e>;
					io-channel-names = "cp_die_temp";
					qcom,parallel-input-mode = <0x01>;
					qcom,parallel-output-mode = <0x02>;
					qcom,min-ilim-ua = <0xb71b0>;

					qcom,core {
						interrupts = <0x10 0x00 0x03 0x10 0x01 0x03 0x10 0x02 0x03 0x10 0x03 0x03 0x10 0x04 0x03 0x10 0x05 0x01 0x10 0x06 0x01 0x10 0x07 0x01>;
						interrupt-names = "switcher-off-window\0switcher-off-fault\0tsd-fault\0irev-fault\0vph-ov-hard\0vph-ov-soft\0ilim\0temp-alarm";
					};
				};
			};

			smb1390_slave: qcom,smb1390_slave@18 {
				compatible = "qcom,i2c-pmic";
				reg = <0x18>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				qcom,periph-map = <0x10>;
				status = "ok";

				smb1390_slave_charger: qcom,charge_pump_slave {
					compatible = "qcom,smb1390-slave";
					status = "ok";
				};
			};
		};
	};
};
