	fragment@18 {
		target = <&soc>;

		__overlay__ {

			led_flash_rear: qcom,camera-flash@0 {
				cell-index = <0x00>;
				reg = <0x00 0x00>;
				compatible = "qcom,camera-flash";
				flash-source = <&pm8150l_flash0 &pm8150l_flash1>;
				torch-source = <&pm8150l_torch0 &pm8150l_torch1>;
				switch-source = <&pm8150l_switch2>;
			};

			led_flash_rear_aux: qcom,camera-flash@1 {
				cell-index = <0x01>;
				reg = <0x01 0x00>;
				compatible = "qcom,camera-flash";
				flash-source = <&pm8150l_flash0 &pm8150l_flash1>;
				torch-source = <&pm8150l_torch0 &pm8150l_torch1>;
				switch-source = <&pm8150l_switch2>;
			};

			led_flash_triple_rear: qcom,camera-flash@4 {
				cell-index = <0x04>;
				reg = <0x04 0x00>;
				compatible = "qcom,camera-flash";
				flash-source = <&pm8150l_flash0 &pm8150l_flash1>;
				torch-source = <&pm8150l_torch0 &pm8150l_torch1>;
				switch-source = <&pm8150l_switch2>;
			};

			led_flash_triple_rear_aux: qcom,camera-flash@5 {
				cell-index = <0x05>;
				reg = <0x05 0x00>;
				compatible = "qcom,camera-flash";
				flash-source = <&pm8150l_flash0 &pm8150l_flash1>;
				torch-source = <&pm8150l_torch0 &pm8150l_torch1>;
				switch-source = <&pm8150l_switch2>;
			};

			led_flash_triple_rear_aux2: qcom,camera-flash@6 {
				cell-index = <0x06>;
				reg = <0x06 0x00>;
				compatible = "qcom,camera-flash";
				flash-source = <&pm8150l_flash0 &pm8150l_flash1>;
				torch-source = <&pm8150l_torch0 &pm8150l_torch1>;
				switch-source = <&pm8150l_switch2>;
			};

			vreg_tof: regulator-dbb1 {
				compatible = "regulator-fixed";
				regulator-name = "vdd_tof";
				regulator-min-microvolt = <0x36ee80>;
				regulator-max-microvolt = <0x36ee80>;
				gpio = <&pm8150l_gpios 0x02 0x00>;
				startup-delay-us = <0x3e8>;
				enable-active-high;
			};

			qcom,cam-res-mgr {
				compatible = "qcom,cam-res-mgr";
				status = "ok";
			};
		};
	};

