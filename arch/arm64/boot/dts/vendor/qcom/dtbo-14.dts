	fragment@30 {
		target = <&ufsphy_mem>;

		__overlay__ {
			compatible = "qcom,ufs-phy-qmp-v3";
			vdda-phy-supply = <&L18A>;
			vdda-pll-supply = <&L22A>;
			vdda-phy-max-microamp = <0xf5b4>;
			vdda-pll-max-microamp = <0x477c>;
			status = "ok";
		};
	};

	fragment@31 {
		target = <&ufshc_mem>;

		__overlay__ {
			vdd-hba-supply = <&gcc_ufs_phy_gdsc>;
			vdd-hba-fixed-regulator;
			vcc-supply = <&L7E>;
			vcc-voltage-level = <0x2d0370 0x2d2a80>;
			vccq2-supply = <&L12A>;
			vccq2-voltage-level = <0x1b7740 0x1b7740>;
			vcc-max-microamp = [00 0c 35 00];
			vccq2-min-microamp = <0x00>;
			vccq2-max-microamp = [00 0c 35 00];
			vccq2-pwr-collapse-sup;
			qcom,vddp-ref-clk-supply = <&L22A>;
			qcom,vddp-ref-clk-max-microamp = <0x64>;
			qcom,vddp-ref-clk-min-uV = <0x119400>;
			qcom,vddp-ref-clk-max-uV = <0x124f80>;
			status = "ok";
		};
	};

	fragment@32 {
		target = <&sdhc_1>;

		__overlay__ {
			vdd-supply = <&L7E>;
			qcom,vdd-voltage-level = <0x2d2a80 0x2d2a80>;
			qcom,vdd-current-level = <0x00 0x8b290>;
			vdd-io-supply = <&L12A>;
			qcom,vdd-io-always-on;
			qcom,vdd-io-lpm-sup;
			qcom,vdd-io-voltage-level = <0x1b7740 0x1b7740>;
			qcom,vdd-io-current-level = <0x00 0x4f588>;
			pinctrl-names = "active\0sleep";
			pinctrl-0 = <&sdc1_clk_on &sdc1_cmd_on &sdc1_data_on &sdc1_rclk_on>;
			pinctrl-1 = <&sdc1_clk_off &sdc1_cmd_off &sdc1_data_off &sdc1_rclk_off>;
			status = "ok";
		};
	};

	fragment@33 {
		target = <&sdhc_2>;

		__overlay__ {
			vdd-supply = <&L9E>;
			qcom,vdd-voltage-level = <0x2d2a80 0x2d2a80>;
			qcom,vdd-current-level = <0x00 0xc3500>;
			vdd-io-supply = <&L6E>;
			qcom,vdd-io-voltage-level = <0x1b7740 0x2d0370>;
			qcom,vdd-io-current-level = <0x00 0x55f0>;
			pinctrl-names = "active\0sleep";
			pinctrl-0 = <&sdc2_clk_on &sdc2_cmd_on &sdc2_data_on &sdc2_cd_on>;
			pinctrl-1 = <&sdc2_clk_off &sdc2_cmd_off &sdc2_data_off &sdc2_cd_off>;
			cd-gpios = <&tlmm 0x5e 0x01>;
			status = "ok";
		};
	};

	fragment@34 {
		target = <&soc>;

		__overlay__ {

			gpio_keys {
				compatible = "gpio-keys";
				label = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&key_vol_up_default>;

				vol_up {
					label = "volume_up";
					gpios = <&pm6350_gpios 0x02 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x73>;
					gpio-key,wakeup;
					debounce-interval = <0x0f>;
					linux,can-disable;
				};
			};
		};
	};

	fragment@35 {
		target = <&pm6350_gpios>;

		__overlay__ {

			key_vol_up {

				key_vol_up_default: key_vol_up_default {
					pins = "gpio2";
					function = "normal";
					input-enable;
					bias-pull-up;
					power-source = <0x00>;
				};
			};
		};
	};

	fragment@36 {
		target = <&pm6150a_amoled>;

		__overlay__ {
			status = "ok";
		};
	};

	fragment@37 {
		target = <&pm7250b_charger>;

		__overlay__ {
			status = "ok";
			io-channels = <&pm7250b_vadc 0x08 &pm7250b_vadc 0x07 &pm7250b_vadc 0x09 &pm7250b_vadc 0x06 &pm7250b_vadc 0x4f &pm7250b_vadc 0x99 &pm7250b_vadc 0x83>;
			io-channel-names = "usb_in_voltage\0usb_in_current\0chg_temp\0die_temp\0conn_temp\0sbux_res\0vph_voltage";
			qcom,batteryless-platform;
			qcom,sec-charger-config = <0x00>;
			qcom,auto-recharge-soc = <0x62>;
			qcom,step-charging-enable;
			qcom,sw-jeita-enable;
			qcom,charger-temp-max = <0x320>;
			qcom,smb-temp-max = <0x320>;
			qcom,suspend-input-on-debug-batt;
		};
	};

	fragment@38 {
		target = <&pm7250b_qg>;

		__overlay__ {
			status = "ok";
			io-channels = <&pm7250b_vadc 0x4a &pm7250b_vadc 0x4b>;
			io-channel-names = "batt-therm\0batt-id";
			qcom,qg-iterm-ma = <0x64>;
			qcom,hold-soc-while-full;
			qcom,linearize-soc;
			qcom,cl-feedback-on;
		};
	};

	fragment@39 {
		target = <&qupv3_se0_i2c>;

		__overlay__ {
			status = "ok";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			nq@28 {
				compatible = "qcom,nq-nci";
				reg = <0x28>;
				qcom,nq-irq = <&tlmm 0x09 0x00>;
				qcom,nq-ven = <&tlmm 0x06 0x00>;
				qcom,nq-firm = <&tlmm 0x08 0x00>;
				qcom,nq-clkreq = <&tlmm 0x07 0x00>;
				qcom,nq-vdd-1p8-supply = <&L11A>;
				qcom,nq-vdd-1p8-voltage = <0x1b7740 0x1b7740>;
				qcom,nq-vdd-1p8-current = <0x26548>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x09 0x00>;
				interrupt-names = "nfc_irq";
				pinctrl-names = "nfc_active\0nfc_suspend";
				pinctrl-0 = <&nfc_int_active &nfc_enable_active &nfc_clk_req_active>;
				pinctrl-1 = <&nfc_int_suspend &nfc_enable_suspend &nfc_clk_req_suspend>;
			};
		};
	};

	fragment@40 {
		target = <&qupv3_se8_i2c>;

		__overlay__ {
			status = "okay";
			qcom,i2c-touch-active = "synaptics,tcm-i2c";

			synaptics_tcm@20 {
				compatible = "synaptics,tcm-i2c";
				reg = <0x20>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x16 0x2008>;
				pinctrl-names = "pmx_ts_active\0pmx_ts_suspend\0pmx_ts_release";
				pinctrl-0 = <&ts_active>;
				pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
				pinctrl-2 = <&pmx_ts_release>;
				vdd-supply = <&L11A>;
				avdd-supply = <&L6A>;
				synaptics,pwr-reg-name = "avdd";
				synaptics,bus-reg-name = "vdd";
				synaptics,irq-gpio = <&tlmm 0x16 0x2008>;
				synaptics,irq-on-state = <0x00>;
				synaptics,reset-gpio = <&tlmm 0x15 0x00>;
				synaptics,reset-on-state = <0x00>;
				synaptics,reset-active-ms = <0x14>;
				synaptics,reset-delay-ms = <0xc8>;
				synaptics,power-delay-ms = <0xc8>;
				synaptics,ubl-i2c-addr = <0x20>;
				synaptics,extend_report;
				synaptics,firmware-name = "synaptics_firmware.img";
				panel = <&dsi_rm69299_visionox_amoled_video &dsi_rm69299_visionox_amoled_cmd>;
			};

			synaptics_dsx@22 {
				compatible = "synaptics,dsx-i2c";
				reg = <0x22>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x27 0x2008>;
				vdd-supply = <&L11A>;
				avdd-supply = <&L6A>;
				pinctrl-names = "pmx_ts_active\0pmx_ts_suspend\0pmx_ts_release";
				pinctrl-0 = <&ts_active>;
				pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
				pinctrl-2 = <&pmx_ts_release>;
				synaptics,pwr-reg-name = "avdd";
				synaptics,bus-reg-name = "vdd";
				synaptics,ub-i2c-addr = <0x22>;
				synaptics,max-y-for-2d = <0x743>;
				synaptics,irq-gpio = <&tlmm 0x16 0x2008>;
				synaptics,reset-gpio = <&tlmm 0x15 0x00>;
				synaptics,irq-on-state = <0x00>;
				synaptics,power-delay-ms = <0xc8>;
				synaptics,reset-delay-ms = <0xc8>;
				synaptics,reset-on-state = <0x00>;
				synaptics,reset-active-ms = <0x14>;
				panel = <&dsi_sharp_qsync_fhd_video &dsi_sharp_qsync_fhd_cmd>;
			};

			focaltech@38 {
				compatible = "focaltech,fts_ts";
				reg = <0x38>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x16 0x2008>;
				focaltech,reset-gpio = <&tlmm 0x15 0x00>;
				focaltech,irq-gpio = <&tlmm 0x16 0x2008>;
				focaltech,max-touch-number = <0x05>;
				focaltech,display-coords = <0x00 0x00 0x438 0x924>;
				vdd-supply = <&L6A>;
				pinctrl-names = "pmx_ts_active\0pmx_ts_suspend\0pmx_ts_release";
				pinctrl-0 = <&ts_active>;
				pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
				pinctrl-2 = <&pmx_ts_release>;
				panel = <&dsi_r66451_amoled_144hz_cmd>;
			};
		};
	};
};
