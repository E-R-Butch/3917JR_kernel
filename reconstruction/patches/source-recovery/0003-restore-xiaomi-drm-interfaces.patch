diff --git a/include/drm/drm_notifier_mi.h b/include/drm/drm_notifier_mi.h
new file mode 100644
index 0000000..998c3a8
--- /dev/null
+++ b/include/drm/drm_notifier_mi.h
@@ -0,0 +1,60 @@
+/*
