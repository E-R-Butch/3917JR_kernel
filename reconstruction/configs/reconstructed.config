# Keep unavailable built-in Coolpad drivers disabled in the first safe baseline.
CONFIG_INPUT_FINGERPRINT=n
CONFIG_GOODIX_GW9558_FINGERPRINT=n
CONFIG_YL_NFC_NXP_SN100F=n
CONFIG_YL_TOUCHSCREEN_FT3518=n
CONFIG_BOOTREASON=n
CONFIG_YL_PSTORE_SSR_REASON=n
CONFIG_YL_RESERVED_RAM=n
CONFIG_OEMINFO=n
CONFIG_YL_POWER_RESET=n
CONFIG_YL_REBOOT_STRESS_TEST=n
CONFIG_YL_DLOAD_MODE=n
CONFIG_SND_SOC_PA_CAL=n

# Use the public FocalTech implementation already present in Yulong's tree.
CONFIG_TOUCHSCREEN_FTS=y

# Iris3 is reconstructed separately after the Qualcomm 4.19 baseline builds.
CONFIG_PXLW_IRIS3=n
CONFIG_PXLW_IRIS3_PLATFORM_7250=n
